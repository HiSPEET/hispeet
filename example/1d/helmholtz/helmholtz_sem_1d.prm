&problem_parameters
 lambda  =  1   ! Helmholtz parameter, lambda >= 0
 problem =  2   ! 1: u=sin(PI*x), 2: u=abs(x)**3
 init    =  0   ! 0: zero, 1: random initial guess
 bc(1)   = 'D'  ! left BC, 'D': Dirichlet, 'N': Neumann
 bc(2)   = 'N'  ! right BC
/

&solution_parameters
 po = 15        ! polynomial order
 ne = 10        ! number of elements
 !i_max = 10    ! max number of iterations
 r_max = 1e-5   ! Euclidic norm of terminal residual
/
