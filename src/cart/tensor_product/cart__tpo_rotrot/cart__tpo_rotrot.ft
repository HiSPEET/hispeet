!>### Double rotation of a vector field: 3D Cartesian equidistant
!===============================================================================

module CART__TPO_RotRot
  use Kind_Parameters, only: RNP
  implicit none
  private

  public :: TPO_RotRot_Proc    ! procedure interface
  public :: TPO_RotRot_Assign  ! procedure assignment
  public :: TPO_RotRot_Eval    ! operator evaluation


  abstract interface

    !---------------------------------------------------------------------------
    !> Abstract interface to 3D CE rot-rot procedures for vectors

    subroutine TPO_RotRot_Proc(np, ne, Ds, dx, u, v)
      use Kind_Parameters,  only: RNP
      integer,   intent(in)  :: np               !< num. points per direction
      integer,   intent(in)  :: ne               !< number of elements
      real(RNP), intent(in)  :: Ds(np,np)        !< 1D standard diff matrix
      real(RNP), intent(in)  :: dx(3)            !< element extensions
      real(RNP), intent(in)  :: u(np,np,np,ne,3) !< 3D vector field
      real(RNP), intent(out) :: v(np,np,np,ne,3) !< v = rot(rot(u))
    end subroutine TPO_RotRot_Proc

  end interface

contains

!-------------------------------------------------------------------------------
!> Assignment of a element divergence operator procedure for given dimension

subroutine TPO_RotRot_Assign(np, Proc)
  integer, intent(in)  :: np  !< number of points per direction
  procedure(TPO_RotRot_Proc), pointer, intent(out) :: Proc

  ! external procedures ........................................................

  procedure(TPO_RotRot_Proc) :: CART__TPO_RotRot__gen

  ! initialization .............................................................

  Proc => null()

  ! parametrized procedures ....................................................

  ! generic procedures .........................................................

  if (.not. associated(Proc)) then
    Proc => CART__TPO_RotRot__gen
  end if

end subroutine TPO_RotRot_Assign

!-------------------------------------------------------------------------------
!> Evaluation of the element divergence operator

subroutine TPO_RotRot_Eval(np, ne, Ds, dx, u, v)
  integer,   intent(in)  :: np               !< num. points per direction
  integer,   intent(in)  :: ne               !< number of elements
  real(RNP), intent(in)  :: Ds(np,np)        !< 1D standard diff matrix
  real(RNP), intent(in)  :: dx(3)            !< element extensions
  real(RNP), intent(in)  :: u(np,np,np,ne,3) !< 3D vector field
  real(RNP), intent(out) :: v(np,np,np,ne,3) !< v = rot(rot(u))

  procedure(TPO_RotRot_Proc), pointer :: Proc

  call TPO_RotRot_Assign(np, Proc)
  call Proc(np, ne, Ds, dx, u, v)

end subroutine TPO_RotRot_Eval

!===============================================================================

end module CART__TPO_RotRot