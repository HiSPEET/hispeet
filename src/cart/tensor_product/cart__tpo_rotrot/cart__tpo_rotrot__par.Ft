!> summary:  Generic rot-rot of a vector field: 3D Cartesian equidistant
!> author:   Joerg Stiller
!> date:     2017/01/31
!> license:  Institute of Fluid Mechanics, TU Dresden, 01062 Dresden, Germany
!>
!>### Generic rot-rot of a vector field: 3D Cartesian equidistant
!===============================================================================

#define __NA__    <np>
#define __NA_T2__ <np_t2>
#define __NA_T4__ <np_t4>
#define __NA_T8__ <np_t8>

subroutine CART__TPO_RotRot__<tag>(np, ne, Ds, dx, u, v)

  !-----------------------------------------------------------------------------
  ! modules

  use Kind_Parameters, only: RNP
  implicit none

  !-----------------------------------------------------------------------------
  ! arguments

  integer,   intent(in)  :: np                     !< points per direction
  integer,   intent(in)  :: ne                     !< number of elements
  real(RNP), intent(in)  :: Ds(<np>,<np>)          !< 1D standard diff matrix
  real(RNP), intent(in)  :: dx(3)                  !< element extensions
  real(RNP), intent(in)  :: u(<np>,<np>,<np>,ne,3) !< 3D vector field
  real(RNP), intent(out) :: v(<np>,<np>,<np>,ne,3) !< v = rot(rot(u))

  !-----------------------------------------------------------------------------
  ! local variables

  real(RNP) :: Dt(<np>,<np>), DDt(<np>,<np>), div_u(<np>,<np>,<np>)
  real(RNP) :: g(3)

  integer :: e, i, j

  !-----------------------------------------------------------------------------
  ! initialization

  ! transposed 1D standard diff matrix, Dt = Ds^T
  do j = 1, <np>
  do i = 1, <np>
    Dt(j,i) = Ds(i,j)
  end do
  end do

  ! transposed 1D standard diff-diff matrix DDt = (Ds Ds)^T
  do j = 1, <np>
  do i = 1, <np>
    DDt(j,i) = sum(Ds(i,:) * Ds(:,j))
  end do
  end do

  ! metric coefficients
  g = 2 / dx

  !-----------------------------------------------------------------------------
  ! evaluation

  !$acc data present(u,v) copyin(Dt,DDt,g) async
  !$acc parallel num_workers(<num_workers>) vector_length(<vec_length>) async
  !$acc loop gang worker private(div_u)

  !$omp do private(e)
  do e = 1, ne

    ! div_u = du1/dx1 + du2/dx2 + du3/dx3
    call SubOp_1i(g(1), Dt, u(:,:,:,e,1), div_u)
    call SubOp_2a(g(2), Dt, u(:,:,:,e,2), div_u)
    call SubOp_3a(g(3), Dt, u(:,:,:,e,3), div_u)

    ! v1 = d(div_u)/dx1 - d(du1/dx1)/dx1 - d(du1/dx2)/dx2 - d(du1/dx3)/dx3
    call SubOp_1i( g(1)   , Dt , div_u       , v(:,:,:,e,1))
    call SubOp_1a(-g(1)**2, DDt, u(:,:,:,e,1), v(:,:,:,e,1))
    call SubOp_2a(-g(2)**2, DDt, u(:,:,:,e,1), v(:,:,:,e,1))
    call SubOp_3a(-g(3)**2, DDt, u(:,:,:,e,1), v(:,:,:,e,1))

    ! v2 = d(div_u)/dx2 - d(du2/dx1)/dx1 - d(du2/dx2)/dx2 - d(du2/dx3)/dx3
    call SubOp_2i( g(2)   , Dt , div_u       , v(:,:,:,e,2))
    call SubOp_1a(-g(1)**2, DDt, u(:,:,:,e,2), v(:,:,:,e,2))
    call SubOp_2a(-g(2)**2, DDt, u(:,:,:,e,2), v(:,:,:,e,2))
    call SubOp_3a(-g(3)**2, DDt, u(:,:,:,e,2), v(:,:,:,e,2))

    ! v3 = d(div_u)/dx3 - d(du3/dx1)/dx1 - d(du3/dx2)/dx2 - d(du3/dx3)/dx3
    call SubOp_3i( g(3)   , Dt , div_u       , v(:,:,:,e,3))
    call SubOp_1a(-g(1)**2, DDt, u(:,:,:,e,3), v(:,:,:,e,3))
    call SubOp_2a(-g(2)**2, DDt, u(:,:,:,e,3), v(:,:,:,e,3))
    call SubOp_3a(-g(3)**2, DDt, u(:,:,:,e,3), v(:,:,:,e,3))

  end do
  !$omp end do

  !$acc end parallel
  !$acc end data

contains

#include "<SubOp_1i>"
#include "<SubOp_1a>"

#include "<SubOp_2i>"
#include "<SubOp_2a>"

#include "<SubOp_3i>"
#include "<SubOp_3a>"

!===============================================================================

end subroutine CART__TPO_RotRot__<tag>

#undef __NA__
#undef __NA_T2__
#undef __NA_T4__
#undef __NA_T8__
