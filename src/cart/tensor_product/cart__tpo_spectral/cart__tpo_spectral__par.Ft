!> summary:  Spectral operator backward-forward marching, separate, parametrized
!> author:   Joerg Stiller
!> date:     2018/11/18
!> license:  Institute of Fluid Mechanics, TU Dresden, 01062 Dresden, Germany
!>
!>### Spectral operator backward-forward marching, separate, parametrized
!===============================================================================

#define __NA__    <na>
#define __NB__    <nb>
#define __NC__    <nc>

subroutine CART__TPO_Spectral__<tag>(na, nb, nc, ne, A, B, C, Lambda, u, v)

  !-----------------------------------------------------------------------------
  ! modules

  use Kind_Parameters, only: RNP
  implicit none

  !-----------------------------------------------------------------------------
  ! arguments

  integer,   intent(in)  :: na                     !< dimension of A
  integer,   intent(in)  :: nb                     !< dimension of B
  integer,   intent(in)  :: nc                     !< dimension of C
  integer,   intent(in)  :: ne                     !< number of elements
  real(RNP), intent(in)  :: A(<na>,<na>)           !< eigenvectors for dir 1
  real(RNP), intent(in)  :: B(<nb>,<nb>)           !< eigenvectors for dir 2
  real(RNP), intent(in)  :: C(<nc>,<nc>)           !< eigenvectors for dir 3
  real(RNP), intent(in)  :: Lambda(<na>,<nb>,<nc>) !< eigenvalues
  real(RNP), intent(in)  :: u(<na>,<nb>,<nc>,ne)   !< operand
  real(RNP), intent(out) :: v(<na>,<nb>,<nc>,ne)   !< result

  !-----------------------------------------------------------------------------
  ! local variables

  real(RNP), parameter   :: ONE = 1
  real(RNP), allocatable :: A_t(:,:), B_t(:,:), C_t(:,:)
  real(RNP), allocatable :: y(:,:,:), z(:,:,:)

  integer :: e, i, j

  !-----------------------------------------------------------------------------
  ! initialization

  ! transposed 1D operators ....................................................

  allocate(A_t(na, na))
  do j = 1, <na>
  do i = 1, <na>
    A_t(j,i) = A(i,j)
  end do
  end do

  allocate(B_t(nb, nb))
  do j = 1, <nb>
  do i = 1, <nb>
    B_t(j,i) = B(i,j)
  end do
  end do

  allocate(C_t(nc, nc))
  do j = 1, <nc>
  do i = 1, <nc>
    C_t(j,i) = C(i,j)
  end do
  end do

  ! workspace ..................................................................

  allocate(y(na, nb, nc), z(na, nb, nc))

  !-----------------------------------------------------------------------------
  ! evaluation

  !$acc data present(u, v) copyin(A, B, C, A_t, B_t, C_t, Lambda) async
  !$acc parallel num_workers(<num_workers>) vector_length(<vec_length>) async
  !$acc loop gang private(y, z)

  !$omp do private(e)
  elements: do e = 1, ne

    ! y = (C^T x I x I) u
    call SubOp_3i(ONE, C, u(:,:,:,e), y)

    ! z = (I x B^T x I) y
    call SubOp_2i(ONE, B, y, z)

    ! y = Lambda (I x I x A^T) z
    call SubOp_1id(ONE, A, Lambda, z, y)

    ! z = I x I x A y
    call SubOp_1i(ONE, A_t, y, z)

    ! y = I x B x I z
    call SubOp_2i(ONE, B_t, z, y)

    ! v = C x I x I y
    call SubOp_3i(ONE, C_t, y, v(:,:,:,e))

  end do elements
  !$omp end do

  !$acc end parallel
  !$acc end data

contains

#include "<SubOp_1id>"

#include "<SubOp_1i>"

#include "<SubOp_2i>"

#include "<SubOp_3i>"

!===============================================================================

end subroutine  CART__TPO_Spectral__<tag>

#undef __NA__
#undef __NB__
#undef __NC__
