!> summary:  3D Cartesian elliptic operator with variable isotropic diffusivity
!> author:   Joerg Stiller
!> date:     2017/01/03
!> license:  Institute of Fluid Mechanics, TU Dresden, 01062 Dresden, Germany
!>
!>### 3D Cartesian elliptic operator with variable isotropic diffusivity
!===============================================================================

module CART__TPO_Diffusion_VI
  use Kind_Parameters, only: RNP
  implicit none
  private

  public :: TPO_Diffusion_VI_Proc    ! procedure interface
  public :: TPO_Diffusion_VI_Assign  ! procedure assignment
  public :: TPO_Diffusion_VI_Eval    ! operator evaluation


  abstract interface

    !---------------------------------------------------------------------------
    !> Abstract interface to the 3D element diffusion operator for scalars
    !>
    !> The procedure evaluates the elliptic operator with constant lambda and
    !> variable nu for equidistant 3D Cartesian elements. Given the scalar
    !> variable u(1:np,1:np,1:np,1:ne), the result is computed as
    !>
    !>     v(i,j,k,e)
    !>
    !>       = c0 * lambda * Ms(i) * Ms(j) * Ms(k) * u(i,j,k,e)
    !>
    !>       + c1 * Ms(j) * Ms(k)
    !>            * sum( nu(:,j,k) * Ms(:) * Ds(:,i) * matmul(Ds, u(:,j,k,e)) )
    !>
    !>       + c2 * Ms(k) * Ms(i)
    !>            * sum( nu(i,:,k) * Ms(:) * Ds(:,j) * matmul(Ds, u(i,:,k,e)) )
    !>
    !>       + c3 * Ms(i) * Ms(j)
    !>            * sum( nu(i,j,:) * Ms(:) * Ds(:,k) * matmul(Ds, u(i,j,:,e)) )
    !>
    !> for each point (i,j,k) in every element e.
    !>
    !> Ms and Ls are the 1D standard mass and stiffness matrices for polynomial
    !> order P = np-1, respectively, dx(1:3) the element dimensions, and
    !>
    !>     c0 = dx(1) * dx(2) * dx(3) / 8
    !>     c1 = dx(2) * dx(3) / (2 * dx(1))
    !>     c2 = dx(3) * dx(1) / (2 * dx(2))
    !>     c3 = dx(1) * dx(2) / (2 * dx(3))
    !>
    !> When compiled with OpenACC and run on a GPU, any call to this procedure
    !> must be followed by an "acc wait" before accessing u or v from CPU or
    !> other than the default accelerator queue.

    subroutine TPO_Diffusion_VI_Proc(np, ne, Ms, Ds, lambda, nu, dx, u, v)
      use Kind_Parameters,  only: RNP
      integer,   intent(in)  :: np              !< number of points per direction
      integer,   intent(in)  :: ne              !< number of elements
      real(RNP), intent(in)  :: Ms(np)          !< 1D standard mass matrix
      real(RNP), intent(in)  :: Ds(np,np)       !< 1D standard diff matrix
      real(RNP), intent(in)  :: lambda          !< Helmholtz parameter
      real(RNP), intent(in)  :: nu(np,np,np,ne) !< diffusivity
      real(RNP), intent(in)  :: dx(3)           !< element extensions
      real(RNP), intent(in)  :: u(np,np,np,ne)  !< operand
      real(RNP), intent(out) :: v(np,np,np,ne)  !< result
    end subroutine TPO_Diffusion_VI_Proc

  end interface

contains

!-------------------------------------------------------------------------------
!> Assignment of an element diffusion operator procedure for given dimension

subroutine TPO_Diffusion_VI_Assign(np, Proc)
  integer, intent(in)  :: np  !< number of points per direction
  procedure(TPO_Diffusion_VI_Proc), pointer, intent(out) :: Proc

  ! external procedures ........................................................

  procedure(TPO_Diffusion_VI_Proc) :: CART__TPO_Diffusion_VI__gen
! procedure(TPO_Diffusion_VI_Proc) :: CART__TPO_Diffusion_VI__gen_2
! procedure(TPO_Diffusion_VI_Proc) :: CART__TPO_Diffusion_VI__gen_3
! procedure(TPO_Diffusion_VI_Proc) :: CART__TPO_Diffusion_VI__gen_4

  ! initialization .............................................................

  Proc => null()

  ! parametrized procedures ....................................................

  ! generic procedures .........................................................

  if (.not. associated(Proc)) then
!   select case(abs(np))
!   case(2)
!     Proc => CART__TPO_Diffusion_VI__gen_2
!   case(3)
!     Proc => CART__TPO_Diffusion_VI__gen_3
!   case(4)
!     Proc => CART__TPO_Diffusion_VI__gen_4
!   case default
      Proc => CART__TPO_Diffusion_VI__gen
!   end select
  end if

end subroutine TPO_Diffusion_VI_Assign

!-------------------------------------------------------------------------------
!> Evaluation of the element diffusion operator

subroutine TPO_Diffusion_VI_Eval(np, ne, Ms, Ds, lambda, nu, dx, u, v)
  integer,   intent(in)  :: np              !< number of points per direction
  integer,   intent(in)  :: ne              !< number of elements
  real(RNP), intent(in)  :: Ms(np)          !< 1D standard mass matrix
  real(RNP), intent(in)  :: Ds(np,np)       !< 1D standard diff matrix
  real(RNP), intent(in)  :: lambda          !< Helmholtz parameter
  real(RNP), intent(in)  :: nu(np,np,np,ne) !< diffusivity
  real(RNP), intent(in)  :: dx(3)           !< element extensions
  real(RNP), intent(in)  :: u(np,np,np,ne)  !< operand
  real(RNP), intent(out) :: v(np,np,np,ne)  !< result

  procedure(TPO_Diffusion_VI_Proc), pointer :: Proc

  call TPO_Diffusion_VI_Assign(np, Proc)
  call Proc(np, ne, Ms, Ds, lambda, nu, dx, u, v)

end subroutine TPO_Diffusion_VI_Eval

!===============================================================================

end module CART__TPO_Diffusion_VI
