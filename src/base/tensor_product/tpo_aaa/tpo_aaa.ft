!> summary:  Evaluation of  v = (AxAxA) u
!> author:   Joerg Stiller
!> date:     2017/02/04
!> license:  Institute of Fluid Mechanics, TU Dresden, 01062 Dresden, Germany
!>
!>### Evaluation of  v = (AxAxA) u
!===============================================================================

module TPO_AAA
  use Kind_Parameters, only: RNP
  implicit none
  private

  public :: TPO_AAA_Proc    ! procedure interface
  public :: TPO_AAA_Assign  ! procedure assignment
  public :: TPO_AAA_Eval    ! operator evaluation


  abstract interface
    subroutine TPO_AAA_Proc(na1, na2, ne, A, u, v)
      use Kind_Parameters, only: RNP
      integer,   intent(in)  :: na1               !< first dimension of A
      integer,   intent(in)  :: na2               !< second dimension of A
      integer,   intent(in)  :: ne                !< number of elements
      real(RNP), intent(in)  :: A(na1,na2)        !< 1D operator
      real(RNP), intent(in)  :: u(na2,na2,na2,ne) !< 3D operand
      real(RNP), intent(out) :: v(na1,na1,na1,ne) !< 3D result
    end subroutine TPO_AAA_Proc
  end interface

contains

!-------------------------------------------------------------------------------
!> Assingment of an AAA operator procedure for given dimensions

subroutine TPO_AAA_Assign(na1, na2, Proc)
  integer, intent(in) :: na1  !< first dimension of A
  integer, intent(in) :: na2  !< second dimension of A
  procedure(TPO_AAA_Proc), pointer, intent(out) :: Proc

  ! external procedures ........................................................

  procedure(TPO_AAA_Proc) :: TPO_AAA__gen

  ! initialization .............................................................

  Proc => null()

  ! parametrized procedures ....................................................

  ! generic procedures .........................................................

  if (.not. associated(Proc)) then
    Proc => TPO_AAA__gen
  end if

end subroutine TPO_AAA_Assign

!-------------------------------------------------------------------------------
!> Evaluation of the AAA operator

subroutine TPO_AAA_Eval(na1, na2, ne, A, u, v)
  integer,   intent(in)  :: na1               !< first dimension of A
  integer,   intent(in)  :: na2               !< second dimension of A
  integer,   intent(in)  :: ne                !< number of elements
  real(RNP), intent(in)  :: A(na1,na2)        !< 1D operator
  real(RNP), intent(in)  :: u(na2,na2,na2,ne) !< 3D operand
  real(RNP), intent(out) :: v(na1,na1,na1,ne) !< 3D result

  procedure(TPO_AAA_Proc), pointer :: Proc

  call TPO_AAA_Assign(na1, na2, Proc)
  call Proc(na1, na2, ne, A, u, v)

end subroutine TPO_AAA_Eval

!===============================================================================

end module TPO_AAA