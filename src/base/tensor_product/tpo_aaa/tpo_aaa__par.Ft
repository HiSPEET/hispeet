!> summary:  Parametrized AxAxA operator
!> author:   Joerg Stiller
!> date:     2016/11/30
!> license:  Institute of Fluid Mechanics, TU Dresden, 01062 Dresden, Germany
!>
!>### Parametrized AxAxA operator
!===============================================================================

#define __NA1__    <na1>
#define __NA1_T2__ <na1_t2>
#define __NA1_T4__ <na1_t4>
#define __NA1_T8__ <na1_t8>

#define __NA2__    <na2>
#define __NA2_T2__ <na2_t2>
#define __NA2_T4__ <na2_t4>

subroutine TPO_AAA__<tag>(na1, na2, ne, A, u, v)

  !-----------------------------------------------------------------------------
  ! modules

  use Kind_Parameters, only: RNP
  implicit none

  !-----------------------------------------------------------------------------
  ! arguments

  integer,   intent(in)  :: na1                     !< first dimension of A
  integer,   intent(in)  :: na2                     !< second dimension of A
  integer,   intent(in)  :: ne                      !< number of elements
  real(RNP), intent(in)  :: A(<na1>,<na2>)          !< 1D operator
  real(RNP), intent(in)  :: u(<na2>,<na2>,<na2>,ne) !< 3D operand
  real(RNP), intent(out) :: v(<na1>,<na1>,<na1>,ne) !< 3D result

  !-----------------------------------------------------------------------------
  ! local variables

  real(RNP), allocatable :: At(:,:), z1(:,:,:), z2(:,:,:)

  integer :: e, i, j

  ! transposed 1D operator .....................................................

  allocate(At(na2, na1))

  do j = 1, __NA2__
  do i = 1, __NA1__
    At(j,i) = A(i,j)
  end do
  end do

  ! workspace ..................................................................

  allocate(z1(na1,na2,na2), z2(na1,na1,na2))

  !-----------------------------------------------------------------------------
  ! evaluation

  !$acc data present(u,v) copyin(At) async
  !$acc parallel num_workers(<num_workers>) vector_length(<vec_length>) async
  !$acc loop gang private(z1,z2)

  !$omp do private(e)
  do e = 1, ne

    call SubOp_1(At, u(:,:,:,e), z1)
    call SubOp_2(At, z1, z2)
    call SubOp_3(At, z2, v(:,:,:,e))

  end do
  !$omp end do

  !$acc end parallel
  !$acc end data

contains

#include "<SubOp_1>"

#include "<SubOp_2>"

#include "<SubOp_3>"

!===============================================================================

end subroutine TPO_AAA__<tag>

#undef __NA1__
#undef __NA1_T2__
#undef __NA1_T4__
#undef __NA1_T8__

#undef __NA2__
#undef __NA2_T2__
#undef __NA2_T4__

