#%Module1.0#####################################################################
##
## module intel-19
##
## ~/privatemodules/intel-19  Joerg Stiller
##
proc ModulesHelp { } {
        global version modroot

        puts stderr "intel-19 - sets the environment for ifort, gcc and open-mpi"
}

module-whatis   "Sets the environment for ifort, gcc and open-mpi"

# Open MPI .....................................................................

set             MPIHOME                 /opt/openmpi/INTEL-19
prepend-path    PATH                    $MPIHOME/bin
prepend-path    MANPATH                 $MPIHOME/share/man
prepend-path    LD_LIBRARY_PATH         $MPIHOME/lib
prepend-path    DYLD_LIBRARY_PATH       $MPIHOME/lib

# allow oversubscription
setenv          OMPI_MCA_rmaps_base_oversubscribe  1

# Compiler ....................................................................

setenv          CC                      $MPIHOME/bin/mpicc
setenv          CXX                     $MPIHOME/bin/mpicxx
setenv          FC                      $MPIHOME/bin/mpifort

# Flags
#setenv          CFLAGS                  "-xCORE-AVX2"
#setenv          CXXFLAGS                "-xCORE-AVX2"
setenv          FFLAGS                  "-xCORE-AVX2"

# Settings for CMake ..........................................................

setenv          CMAKE_C_COMPILER        $MPIHOME/bin/mpicc
setenv          CMAKE_CXX_COMPILER      $MPIHOME/bin/mpicxx
setenv          CMAKE_Fortran_COMPILER  $MPIHOME/bin/mpifort

setenv          PFUNIT                  /opt/pfunit/INTEL-19
setenv          PARMETIS                /opt/metis/INTEL-19
setenv          EXODUS                  /opt/exodus/INTEL-19

# Settings for Make ...........................................................

prepend-path    LD_LIBRARY_PATH         /opt/local/lib

## VTK
setenv          VTK_LIB                 vtkIOXML-8.1
setenv          VTK_INC                 /opt/local/include/vtk-8.1
setenv          VTK_DIR                 /opt/local/lib

# METIS+ParMETIS
setenv          METIS_LIB               "parmetis metis"
setenv          METIS_INC               /opt/metis/INTEL-19/include
setenv          METIS_DIR               /opt/metis/INTEL-19/lib
prepend-path    LD_LIBRARY_PATH         /opt/metis/INTEL-19/lib

# EXODUS
setenv          EXODUS_LIB              "exodus netcdf"
setenv          EXODUS_INC              /opt/exodus/INTEL-19/include
setenv          EXODUS_DIR              /opt/exodus/INTEL-19/lib
prepend-path    LD_LIBRARY_PATH         /opt/exodus/INTEL-19/lib
prepend-path    DYLD_LIBRARY_PATH       /opt/exodus/INTEL-19/lib

# FFTW
setenv          FFTW_LIB                fftw3
setenv          FFTW_INC                /opt/local/include
setenv          FFTW_DIR                /opt/local/lib
