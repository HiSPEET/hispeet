&test_case
 test   = 2  ! {1,2,3,4} = {simple 1d/2d/3d, knotty}
 lambda = 1
 nu_1   = 0.1
 k_nu   = 1
 d_nu   = 1.256637061435917
 bc     = 'D','D','D','D','N','N'
!bc     = 6*'D'
!bc     = 'D','D','N','N','P','P'
/

&discretization
 np = 1,1,1
 ep = 4,4,4
!np = 2,2,2
!ep = 2,2,2
 po = 16
!penalty = 2
/

&solver
 method = 1  ! 0: none, 1: CG, 2: Schwarz, 3: Schwarz-PCG, 4: p-MG, 5: p-MG/CG
/

&solver_cg
 i_max  = 100           ! [ huge(1) ]
 r_red  = 1E-10         ! [ 1E-6    ]
/

&solver_schwarz
 i_max  = 100                    ! [ huge(1) ]
 r_red  = 1E-3                   ! [ 1E-6    ]
 schwarz_opt%delta     = 3*0.125 ! [ 3*0.125]
 schwarz_opt%no_min    = 1       ! [ 1 ]
 schwarz_opt%weighting = 5       ! [ 5 ]
/

&solver_schwarz_pcg
 i_max  = 100                    ! [ huge(1) ]
 r_red  = 1E-3                   ! [ 1E-6    ]
 schwarz_opt%delta     = 3*0.08  ! [ 3*0.125]
 schwarz_opt%no_min    = 1       ! [ 1 ]
 schwarz_opt%weighting = 5       ! [ 5 ]
/

&solver_pmg
!pmg_opt%po_top  will be set to po
 pmg_opt%po_bot             =  1
 pmg_opt%i_max              =  4
 pmg_opt%ns1                =  1
 pmg_opt%ns2                =  1
 pmg_opt%mvs                =  1
!pmg_opt%smoother           = 'P'
 pmg_opt%schwarz%delta      =  3*0.125 ! [ 3*0.125]
!pmg_opt%schwarz%no_min     =  1       ! [ 1 ]
!pmg_opt%schwarz%weighting  =  5       ! [ 5 ]
 pmg_opt%r_red              =  1e-10
 pmg_opt%r_max              = -1e-10
 pmg_opt%dr_min             = -1e-10
!pmg_opt%solver             = 'S'
 pmg_opt%i0_max             =  1000
 pmg_opt%r0_red             =  1E-6
 pmg_opt%monitor            =  T
/

&control
!plot_file = 'elliptic_test__ip_vi'
/

