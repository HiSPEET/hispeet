&control
  flow_type     =  'Vortex_TG' ! 'Vortex_TG' for 2D-case and 'Transition_TG' for 3D
  flow_case     =  'vortex_tg' ! 2D: 'vortex_tg', 3D: 'transition_tg'
  restart       =  F
  compute_p     =  T
  write_stat    =  T
  write_vtk     =  F
  eval_rms      =  T
  eval_max      =  F
  eval_eps      =  F
!
  flow_op_control%chi            = -2     ! [-1]
  flow_op_control%div_penalty    =  0     ! [1]
  flow_op_control%div_coeff      =  1     ! [1]
  flow_op_control%div_i_max      =  100   ! [10]
  flow_op_control%div_final      =  F     ! [T]
/

&discretization
  np   =  1,1,1
  ep   =  4,4,1
  po_u =  10   ! 10
  po_p =   9   ! 9
  po_q =  16   ! 16
  penalty = 20
  adjust_dx = T
/

&elliptic_solver
!
! u \ p
  pmg_u_opt%i_max           =  4
  pmg_u_opt%r_red           =  1e-12
  pmg_u_opt%r_max           =  1e-14
  pmg_u_opt%i0_max          =  1000
  pmg_u_opt%r0_red          =  1e-10
  pmg_u_opt%schwarz%delta   =  0.08
  pmg_u_opt%schwarz%no_min  =  1
  pmg_u_opt%monitor         =  F
!
! p
  pmg_p_opt%i_max           =  5
  pmg_p_opt%r_red           =  1e-12
  pmg_p_opt%r_max           =  1e-14
  pmg_p_opt%i0_max          =  1000
  pmg_p_opt%r0_red          =  1e-10
  pmg_p_opt%schwarz%delta   =  0.08
  pmg_p_opt%schwarz%no_min  =  1
  pmg_p_opt%monitor         =  F
/

&time_integration
!
! time stepping
  t_end  = 1.0
  dt     = 0.005
 !c_conv = 1.0
 !c_diff = 100
  nt_max = 100000
!
! time-integration method:
! 1  Euler
![2  TR         ]
! 3  RK
! 4  SDC-orig
! 5  SDC(Eu,Eu)
![6  SDC(TR,Eu) ]
! 7  SDC(RK,Eu)
  time_method = 3
!
! section for standalone Runge-Kutta
  rk_opt%n_stage     = 4
  rk_opt%method      = 2
  rk_opt%project     = 0
  rk_opt%rotational  = 1
  rk_opt%F_d1_method = 3
  rk_opt%variant     = 1
!
  sdc_orig_opt%n_sub   =  3
  sdc_orig_opt%n_sweep =  6
!
! section for SDC(*,*)
  sdc_opt%n_sub       = 3
  sdc_opt%n_sweep     = 1
  pre_rk_opt%n_stage  = 3
  pre_rk_opt%method   = 1
  pre_rk_opt%project  = 0
  pre_rk_opt%variant  = 1 
/

