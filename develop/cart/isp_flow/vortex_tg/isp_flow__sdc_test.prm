&control
! 'vortex_tg' 'vortex_hw' 'stokes_dkm' 'stokes_gms'
  flow_type     =  'vortex_tg'
  flow_case     =  'vortex_tg'
  compute_p     =  F
  write_stat    =  T
  write_vtk     =  F
!
  flow_op_control%chi            = -2     ! [-2.0]
  flow_op_control%f_d3           =  0     ! [0]
!
  flow_op_control%div_penalty    =  1     ! [1]
  flow_op_control%div_coeff      =  1     ! [1]
  flow_op_control%div_i_max      =  10    ! [10]
! flow_op_control%div_final      =  T     ! [F]
!
! flow_op_control%n_outer        =  4     ! [-1]
! flow_op_control%n_inner        = -1     ! [-1]
!
  flow_op_control%sdc_diffusion  =  2     ! [1]
  flow_op_control%sdc_pressure   =  1     ! [0]
  flow_op_control%sdc_lo_op      =  2     ! [2]
  flow_op_control%sdc_div_pen    =  0     ! [0]
!
! flow_op_control%monitor        =  0
/
/

&discretization
  np   =  1,1,1
  ep   =  4,4,1
  po_u =  10
  po_p =   9
  po_q =  16
  penalty = 20
  adjust_dx = T
/

&elliptic_solver
!
! u \ p
! pmg_u_opt%po_bot          =  4
  pmg_u_opt%i_max           =  4 !4
  pmg_u_opt%r_red           =  1e-12
  pmg_u_opt%r_max           =  1e-14
! pmg_u_opt%solver          =  'S'
  pmg_u_opt%i0_max          =  1000
  pmg_u_opt%r0_red          =  1e-10
  pmg_u_opt%schwarz%delta   =  0.08
  pmg_u_opt%schwarz%no_min  =  1
  pmg_u_opt%monitor         =  F
!
! p
  pmg_p_opt%i_max           =  5 !4
  pmg_p_opt%r_red           =  1e-12
  pmg_p_opt%r_max           =  1e-14
! pmg_p_opt%solver          =  'C'
  pmg_p_opt%i0_max          =  1000
  pmg_p_opt%r0_red          =  1e-10
  pmg_p_opt%schwarz%delta   =  0.08
  pmg_p_opt%schwarz%no_min  =  1
  pmg_p_opt%monitor         =  F
/

&time_integration
!
! time stepping
  t_end  = 0.25
  dt     = 0.002
 !c_conv = 1.0
 !c_diff = 100
  nt_max = 10 !0000
!
! SDC
  sdc_opt%n_sub   =  3
  sdc_opt%n_sweep =  2
/

