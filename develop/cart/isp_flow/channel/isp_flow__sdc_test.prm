&control
  flow_type     =  'Channel'
  flow_case     =  'channel'
  restart       =  F
  compute_p     =  F
  write_stat    =  T
  export_vtk    =  F
  eval_rms      =  T
  eval_max      =  F
  eval_eps      =  F
  average       =  F
!
  flow_op_control%chi            = -2       ! [-1]
!
! *** activate in case of continuity problems:
! flow_op_control%div_penalty    =  1       ! [1]
! flow_op_control%div_coeff      =  1       ! [1]
! flow_op_control%div_i_max      =  100     ! [10]
!
! *** can be helpful in case of variable or turbulent viscosity:
! flow_op_control%div_final      =  F       ! [T]
!
! *** activate for use with SVV:
! flow_op_control%svv            =  T       ! [F]
!
! *** activate for use with Sigma model:
! flow_op_control%sgs            =  1 
! flow_op_control%sgs_coeff      =  1.35    ! adjust when using static model
! flow_op_control%sgs_dyn        = .true.   ! recommended
! flow_op_control%sgs_dyn_po_c   =  0       ! [0: auto]
! flow_op_control%sgs_smooth     = .false   ! worth trying
! flow_op_control%sgs_smooth_wt  =  0.005   ! decrease when CFL ≫ 0.1
/

! using 12 elements of degree 16 in y-direction yields y⁺ ≈ 0.4 for Re_τ = 1180
&discretization
  np   =   1, 1, 2
  ep   =   6, 6, 5
 !ep   =  12,12,10
 !np   =   4, 3, 2
 !ep   =   3, 4, 5
  po_u =  16
  po_p =  15
  po_q =  24
  penalty = 20
/

&elliptic_solver
!
! u \ p
  pmg_u_opt%i_max           =  4
  pmg_u_opt%r_red           =  1e-8
  pmg_u_opt%r_max           =  1e-10
  pmg_u_opt%i0_max          =  1000
  pmg_u_opt%r0_red          =  1e-10
  pmg_u_opt%schwarz%delta   =  0.08
  pmg_u_opt%schwarz%no_min  =  1
  pmg_u_opt%monitor         =  F
!
! p
  pmg_p_opt%i_max           =  5
  pmg_p_opt%r_red           =  1e-8
  pmg_p_opt%r_max           =  1e-10
  pmg_p_opt%i0_max          =  1000
  pmg_p_opt%r0_red          =  1e-10
  pmg_p_opt%schwarz%delta   =  0.08
  pmg_p_opt%schwarz%no_min  =  1
  pmg_p_opt%monitor         =  F
/

&time_integration
!
! time stepping
  t_end  = 0.25
 !dt     = 0.002
  c_conv = 0.1
 !c_diff = 100
  nt_max = 1!00000
!
! time-integration method:
! 0  SDC-orig
! 1  Euler
! 2  BDF2
! 3  TR
! 4  RK
! 5  SDC(Eu,Eu)
! 6  SDC(TR,Eu)
! 7  SDC(RK,Eu)
  time_method = 2
!
! section for "original" SDC -- method 0
  sdc_orig_opt%n_sub   =  2
  sdc_orig_opt%n_sweep =  1
!
! section for Euler -- method 1
  eu_opt%TimeIntegratorOptions%project   = 0
  eu_opt%TimeIntegratorOptions%pressure  = 0
!
! section for BDF2 -- method 2
  bdf2_opt%TimeIntegratorOptions%project   = 0
  bdf2_opt%TimeIntegratorOptions%pressure  = 0
!
! section for TR -- method 3
  tr_opt%TimeIntegratorOptions%project   = 0
  tr_opt%TimeIntegratorOptions%pressure  = 0
 !tr_opt%i_max_p1 = 2
 !tr_opt%i_max_u1 = 1
 !tr_opt%i_max_p2 = 2
 !tr_opt%i_max_u2 = 1
!
! section for Runge-Kutta -- method 4
  rk_opt%TimeIntegratorOptions%project   = 1
  rk_opt%TimeIntegratorOptions%pressure  = 0
  rk_opt%n_stage   = 4
  rk_opt%method    = 2
!
! section for SDC(*,Eu) -- methods 5:7
  sdc_opt_rk%Flow_SDC_Options%SDC_Options%nodes   = 'L'
  sdc_opt_eu%Flow_SDC_Options%SDC_Options%n_col   = 2
  sdc_opt_eu%Flow_SDC_Options%SDC_Options%n_sweep = 1
  sdc_opt_eu%Flow_SDC_Options%project   = 0
  sdc_opt_eu%Flow_SDC_Options%pressure  = 0
/

