&control
  flow_type     =  'VariableViscosity'
  flow_case     =  'variable_viscosity'
  compute_p     =  T
  write_stat    =  T
  write_vtk     =  F
!
  flow_op_control%chi            = -2     ! [-1.0]
  flow_op_control%f_d3           =  0     ! [0]
!
  flow_op_control%div_penalty    =  1     ! [0]    ! activate div penalization
  flow_op_control%div_coeff      =  1     ! [10]   ! div penalty factor
  flow_op_control%div_i_max      =  10    ! [20]   ! max num iterations for div penalization
  flow_op_control%div_final      =  T     ! [F]    ! perform final projection step
!
! flow_op_control%n_outer        =  4     ! [-1]   ! num of add coupled iterations (p,friction)
! flow_op_control%n_inner        =  1     ! [-1]   ! num inner iterations
!
  flow_op_control%sdc_diffusion  =  5     ! [2]
! flow_op_control%sdc_pressure   =  0     ! [0]
! flow_op_control%sdc_lo_op      =  2     ! [2]
! flow_op_control%sdc_div_pen    =  0     ! [0]
!
! flow_op_control%monitor        =  0
/

&discretization
  np   =  <np1>,<np2>,<np3>
  ep   =  <ep1>,<ep2>,<ep3>
  po_u =  <po_u>
  po_p =  <po_p>
  po_q =  <po_q>
  penalty = 20
/

&elliptic_solver
!
! u \ p
! pmg_u_opt%po_bot          =  8
  pmg_u_opt%i_max           =  8 !4
  pmg_u_opt%ns1             =  2
  pmg_u_opt%ns2             =  2
  pmg_u_opt%mvs             =  1
  pmg_u_opt%r_red           =  1e-12
  pmg_u_opt%r_max           =  1e-14
  pmg_u_opt%dr_min          =  1e-10
! pmg_u_opt%solver          =  'S'
  pmg_u_opt%i0_max          =  1000
  pmg_u_opt%r0_red          =  1e-10
  pmg_u_opt%schwarz%delta   =  0.125
  pmg_u_opt%schwarz%no_min  =  1
  pmg_u_opt%monitor         =  F
!
! p
  pmg_p_opt%i_max           =  8 !4
  pmg_p_opt%ns1             =  2
  pmg_p_opt%ns2             =  2
  pmg_p_opt%r_red           =  1e-12
  pmg_p_opt%r_max           =  1e-14
  pmg_p_opt%dr_min          =  1e-10
! pmg_p_opt%solver          =  'C'
  pmg_p_opt%i0_max          =  1000
  pmg_p_opt%r0_red          =  1e-10
  pmg_p_opt%schwarz%delta   =  0.125
  pmg_p_opt%schwarz%no_min  =  1
  pmg_p_opt%monitor         =  F
/

&time_integration
!
! time stepping
  t_end  = 0.5
  dt     = <dt>
 !c_conv = <c_conv>
 !c_diff = 100
  nt_max = 10000000
!
! SDC
  sdc_opt%n_sub   =  <n_sub>
  sdc_opt%n_sweep =  <n_sweep>
/

