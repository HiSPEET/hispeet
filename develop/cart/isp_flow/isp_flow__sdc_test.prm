&control
! 'vortex_tg' 'vortex_hw' 'stokes_dkm' 'stokes_gms'
  flow_type     =  'vortex_tg'
  flow_case     =  'vortex_tg'
  compute_p     =  T
  write_stat    =  T
  write_vtk     =  T
  monitor_level =  0
/

&discretization
  np   =  1,1,1
  ep   =  4,4,1
  po_u =  12
! po_q =  19
  penalty = 2
  adjust_dx = T
/

&elliptic_solver
!
! u \ p
! pmg_u_opt%po_bot  =  4
  pmg_u_opt%i_max   =  4 !4
  pmg_u_opt%r_red   =  1e-12
  pmg_u_opt%r_max   =  1e-14
! pmg_u_opt%solver  =  'Schwarz'
  pmg_u_opt%i0_max  =  1000
  pmg_u_opt%r0_red  =  1e-10
  pmg_u_opt%delta   =  0.08
  pmg_u_opt%no_min  =  1
  pmg_u_opt%monitor =  F
!
! p
  pmg_p_opt%i_max   =  5 !4
  pmg_p_opt%r_red   =  1e-12
  pmg_p_opt%r_max   =  1e-14
! pmg_p_opt%solver  =  'CG'
  pmg_p_opt%i0_max  =  1000
  pmg_p_opt%r0_red  =  1e-10
  pmg_p_opt%delta   =  0.08
  pmg_p_opt%no_min  =  1
  pmg_p_opt%monitor =  F
/

&time_integration
!
! time stepping
  t_end  = 0.5
  dt     = 0.002
 !c_conv = 1.0
 !c_diff = 100
  nt_max = 100000
!
! SDC
  propagator      =  1    ! Euler VC|PC|CS {1,2,3} [1]
  sdc_opt%n_sub   =  3
  sdc_opt%n_sweep =  6
  sdc_opt%n_cpi   =  0
/

