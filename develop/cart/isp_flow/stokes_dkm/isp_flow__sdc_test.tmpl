&control
  flow_type     =  'Stokes_DKM'
  flow_case     =  'stokes_dkm'
  compute_p     =  T
  write_stat    =  T
  write_vtk     =  F

  flow_op_control%div_penalty    =  0     ! [1]
  flow_op_control%div_final      =  F     ! [T]
/

&discretization
  np   =  <np1>,<np2>,1
  ep   =  <ep1>,<ep2>,1
  po_u =  <po_u>
  po_p =  <po_p>
  penalty = 20
  adjust_dx = T
/

&elliptic_solver
!
! u \ p
  pmg_u_opt%i_max           =  4
  pmg_u_opt%r_red           =  1e-10
  pmg_u_opt%r_max           =  1e-12
  pmg_u_opt%i0_max          =  1000
  pmg_u_opt%r0_red          =  1e-10
  pmg_u_opt%schwarz%delta   =  0.08
  pmg_u_opt%schwarz%no_min  =  1
  pmg_u_opt%monitor         =  F
!
! p
  pmg_p_opt%i_max           =  4
  pmg_p_opt%r_red           =  1e-10
  pmg_p_opt%r_max           =  1e-12
  pmg_p_opt%i0_max          =  1000
  pmg_p_opt%r0_red          =  1e-10
  pmg_p_opt%schwarz%delta   =  0.08
  pmg_p_opt%schwarz%no_min  =  1
  pmg_p_opt%monitor         =  F
/

&time_integration
!
! time stepping
  t_end  = 0.1
  dt     = <dt>
 !c_conv = 1.0
 !c_diff = 100
  nt_max = 10000000 
!
! SDC
  sdc_opt%n_sub   =  <n_sub>
  sdc_opt%n_sweep =  <n_sweep>
/

