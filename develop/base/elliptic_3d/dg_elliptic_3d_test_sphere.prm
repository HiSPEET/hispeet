&control_prm
  config = 1
  n_test = 1
! export_vtk = T
/

&problem_prm
  test_problem = 5
  alpha = 10
/

&dicretization_prm
  po = 7
/

&solver_prm
! method:
! 0  none
! 1  CG
! 2  Schwarz
! 3  Schwarz-preconditioned CG
  method = 3
  i_max  = 5
  r_red  = 1E-3
  schwarz_opt%delta = 0.2
/

! config = 1
&cuboid_cartesian_prm
! regular    = F ! mimic irregular mesh (elements deformed or of different size)
! structured = F ! mimic unstructured mesh
  xo = 3*0.0
  lx = 3*1.0
  np = 3*
  ep = 3*4
/

