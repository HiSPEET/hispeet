&control_prm
  config = 4
  n_test = 1
! export_vtk = T
/

&problem_prm
  test_problem = 4
! bc = 6*'P'
/

&discretization_prm
  po = 7
/

&solver_prm
! method:
! 0  none
! 1  CG
! 2  Schwarz
! 3  Schwarz-preconditioned CG
  method = 3
  i_max  = 5
  r_red  = 1E-3
  schwarz_opt%delta = 0.2
/

! config = 1
&cuboid_cartesian_prm
! regular    = F ! mimic irregular mesh (elements deformed or of different size)
! structured = F ! mimic unstructured mesh
  np = 1,1,2
  ep = 4,4,2
! periodic = 3*T
/

! config = 2
&cuboid_diamonds_prm
/

! config = 3
&cuboid_onerotated_prm
! rotation = 3*0   ! x/y/z-rotation of center element
  rotation = 1,2,3 ! x/y/z-rotation of center element
! periodic = F,F,F ! F/T for non/periodic directions
! pg = 3           ! polynomial order of geometry
/

! config = 4
&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 3
  pg = 7
/

! config = 5
&annulus_prm
  pg = 7
/

! config = 6
&spherical_shell_segment_prm
! structured = F ! mimic unstructured mesh
  np = 3*1
  ep = 3*4
  pg = 7
/
