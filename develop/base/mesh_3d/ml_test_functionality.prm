&control
  log_level = 2
  file = 'cylinder_2d' ! mesh file base name (gmsh/*.msh)
/

&ml_mesh_options_3d__static
  l_top          =  2
! l_adapt        =  2
! n_bnd          =  1
! n_box          =  1
  n_parts_root   =  1
  n_parts_growth =  2
/

&ml_mesh_options_3d__dynamic
  refinement = 's'  ! (l_top-1)       {'c','s'}
  adapt_bnd  =  1   ! (n_bnd)
! adapt_box  =      ! (3,2,n_box)
! adapt_tol  =      ! (l_top-1)
/

&operators
  po = 1, 2
/
