&control
  file = 'cylinder_2d' ! mesh file base name (gmsh/*.msh)
/

&ml_mesh_options_3d__static
  l_top          = 1
! l_adapt        = 2
! n_bnd          = 1
! n_box          = 1
  n_parts_root   = 1
  n_parts_growth = 2
/

&ml_mesh_options_3d__dynamic
  refinement = 'c'
  adapt_bnd  = 1
! adapt_box  =
! adapt_tol  =
/

&operators
  po = 1
/
