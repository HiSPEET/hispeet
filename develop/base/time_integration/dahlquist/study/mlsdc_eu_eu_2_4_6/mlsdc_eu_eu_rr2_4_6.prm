&discretization_prm

! dt_slab  =  1     ! thickness of one time slab
  n_level  =  3      ! number of space-time levels
  n_cycle  =  14
  n_coarse =  2
  n_time   =  1 1 1
  p_time   = 2 4 6
/

&time_integration_prm

  mg_start = 3 ! 0 Constant
               ! 1  Predictor
               ! 2  Cascade
               ! 3  FMG (not implemented yet)

  ! standalone or predictor method
  time_method = 1 ! 1  Euler
                  ! 3  Implicit streamline diffusion

  ! SDC method
  sdc_method  = 1 ! 0  none (use standalone time integrator)
                  ! 1  based on Euler
                  ! 2  based on ISD of order 1

  ! standalone integrator and predictor options ................................

  ! Euler
  opt_pre_euler%impl    = 2

  ! implicit streamline diffusion
  opt_pre_isd%order   = 1
  opt_pre_isd%n_stage = 1 ! make it a ML variable

  ! SDC options ................................................................

  ! 1 SDC based on Euler
  opt_sdc_euler%nodes = 'RR'
  opt_sdc_euler%impl      = 2

  ! 2 SDC based on ISD
  opt_sdc_isd%nodes = 'RR'
  opt_sdc_isd%n_stage   = 1 ! make it a ML variable
/

&input
  ! test parameters ............................................................

  c_min =  0
  c_max =  20
  d_min =  -5
  d_max =  10
  nc    =  2000
  nd    =  2000

/
