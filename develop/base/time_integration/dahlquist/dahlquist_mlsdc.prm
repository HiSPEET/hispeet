&discretization_prm
! dt_slab  =  1     ! thickness of one time slab
  n_level  =  1      ! number of space-time levels
  n_cycle  =  5
  n_coarse =  2
  n_time   =  1   1
  p_time   = 11  13
/

&time_integration_prm

  incremental = T

  mg_start = 2 ! 1  Predictor
               ! 2  Cascade
               ! 3  FMG (not implemented yet)
  
  ! standalone or predictor method
  time_method = 2 ! 1  Euler
                  ! 2  !!Trapezoidal rule
                  ! 3  Implicit streamline diffusion
                  ! 4  !!Runge-Kutta (default)

  ! SDC method
  sdc_method  = 2 ! 0  none (use standalone time integrator)
                  ! 1  based on Euler
                  ! 2  based on ISD of order 1
                  ! 3  based on parallel backward Euler

! standalone integrator and predictor options ................................

  ! Euler
  opt_pre_euler%impl    = 2  ! 0/1/2: explicit/implicit/IMEX

  ! Trapezoidal rule
  !tint_opt_tr%impl    = 2  ! 0/1/2: explicit/implicit/IMEX

  ! implicit streamline diffusion
  opt_pre_isd%order   = 1  ! theoretical order of convergence {1,2} [1]
  opt_pre_isd%n_stage = 2  ! number of stages, ignored with order 2

  ! Runge-Kutta
  !tint_opt_rk%impl    = 1  ! 0/1/2: explicit/implicit/IMEX
  !tint_opt_rk%n_stage = 4  ! number of stages
  !tint_opt_rk%method  = 2  ! RK method selector, if more than one exist

  ! SDC options ................................................................

  ! SDC based on Euler
  opt_sdc_euler%nodes     = 'L'  ! 'E'/'L'/'RR': equidistant/Lobatto/Radau-right
  opt_sdc_euler%impl      =  2   ! 0/1/2: explicit/implicit/IMEX

  ! SDC based on parallel backward Euler
  opt_sdc_euler_bepar%nodes = 'L'
  opt_sdc_euler_bepar%impl  =  2

  ! SDC based on ISD
  opt_sdc_isd%nodes     = 'RR' ! 'E'/'L'/'RR': equidistant/Lobatto/Radau-right
  opt_sdc_isd%n_stage   =  2   ! 1/2 for 1- or 2-stage corrector
  opt_sdc_isd%c_isd     =  1   ! artificial diffusivity factor [1]
  opt_sdc_isd%scaling   =  1   ! artificial diffusivity scaling: 0/1/2 none/k/double [0]
/

&input
  ! test parameters ............................................................

  c_min =    0.1  ! min convective CFL number            ! for stability
  c_max =    0.2  ! max convective CFL number            !
  d_min =   -0.2  ! min diffusion number                 !
  d_max =   -0.1  ! max diffusion number                 !
  nc    =    80  ! num intervals along imaginary axis   !
  nd    =    80  ! num intervals along real axis        !
/
