&input

  ! time-integration method ....................................................

  ! standalone or predictor method
  time_method = 1 ! 1  Euler
                  ! 2  Trapezoidal rule
                  ! 3  Runge-Kutta

  ! SDC method
  sdc_method  = 1 ! 0  none (use standalone time integrator)
                  ! 1  based on Euler
                  ! 3  based on Runge-Kutta (default)

  ! standalone integrator and predictor options ................................

  ! Euler
  tint_opt_eu%impl    = 1  ! 0/1/2: explicit/IMEX/implicit

  ! Trapezoidal rule
  tint_opt_tr%impl    = 1  ! 0/1/2: explicit/IMEX/implicit

  ! Runge-Kutta
  tint_opt_rk%impl    = 1  ! 0/1/2: explicit/IMEX/implicit
  tint_opt_rk%n_stage = 4  ! number of stages
  tint_opt_rk%method  = 2  ! RK method selector, if more than one exist

  ! SDC options ................................................................

  ! SDC based on Euler
  sdc_opt_eu%n_sub     = 3  ! number of subintervals
  sdc_opt_eu%n_sweep   = 5  ! max number of correction sweeps
  sdc_opt_eu%point_set = 2  ! equidistant (1) or Lobatto (2) points
  sdc_opt_eu%impl      = 1  ! 0/1/2: explicit/IMEX/implicit

  ! SDC based on Runge-Kutta
  sdc_opt_rk%n_sub     = 3  ! number of subintervals
  sdc_opt_rk%n_sweep   = 5  ! max number of correction sweeps
  sdc_opt_rk%point_set = 2  ! equidistant (1) or Lobatto (2) points
  sdc_opt_rk%impl      = 1  ! 0/1/2: explicit/IMEX/implicit
  sdc_opt_rk%n_stage   = 4  !< number of stages of the RK corrector
  sdc_opt_rk%method    = 2  !< RK method selector, if more than one exist

  ! test parameters ............................................................

! c_min =   0  ! min convective CFL number            ! for stability
! c_max =  10  ! max convective CFL number            !
! d_min =  -5  ! min diffusion number                 !
! d_max =  10  ! max diffusion number                 !
! nc    = 400  ! num intervals along imaginary axis   ! 
! nd    = 400  ! num intervals along real axis        ! 

  c_min =   0  ! min convective CFL number            ! for accuracy
  c_max =   4  ! max convective CFL number            !
  d_min =  -2  ! min diffusion number                 !
  d_max =   2  ! max diffusion number                 !
  nc    = 1600  ! num intervals along imaginary axis   ! 
  nd    = 1600  ! num intervals along real axis        ! 

/
