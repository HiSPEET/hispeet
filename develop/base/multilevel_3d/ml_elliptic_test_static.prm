&control_prm
! log_level = 0
! log_level_inner_iteration = 0
! log_level_outer_iteration = 0
! log_level_multigrid_cycle = 0

! export_vtk = .false.
/

&domain_prm
! test_domain = 1
! gmsh_file   = '../gmsh_3d/cylinder_2d'
/

! test_domain = 1
&cuboid_cartesian_prm
! regular    = F ! mimic deformed mesh
! structured = F ! mimic unstructured mesh
  np = 1,1,1
  ep = 4,4,4
! periodic = 3*T
/

! test_domain = 2
&cuboid_diamonds_prm
/

! config = 4
&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 3
  pg = 7
/

&ml_mesh_options_3d__static
  l_top          = 4  ! top level                            [1]
  n_parts_root   = 1  ! number of partitions at root level   [1]
  n_parts_growth = 2  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 'c','c','s' ! (1:l_top-1)
/

&problem_prm
! test_problem = 3

! lambda = 0
! nu_0   = 1
! nu_1   = 0
! d_nu   = 0

! bc = ...
/

&solver_prm

  po = 1, 2, 4, 4  ! (1:l_top)  sequence of polynomial degrees          [1]

! ml_elliptic_opt % penalty           = 2.0   ! penalty parameter > 1   [2]
! ml_elliptic_opt % schwarz % delta   = 0.125 ! relative overlap  ≤ 1   [?]
! ml_elliptic_opt % schwarz % no_min  =  1    ! min overlap in points   [?]
! ml_elliptic_opt % projection_method = 'I'   ! {'I','P'}               ['I']
! ml_elliptic_opt % start_method      =  2    ! none/CASC/FMG = 0/1/2   [2]
! ml_elliptic_opt % smooth_method     =  2    ! CG/WS/SPCG    = 1/2,3   [2]
! ml_elliptic_opt % coarse_solver     =  3    ! CG/WS/SPCG    = 1/2,3   [3]

! ml_elliptic_opt % i_crs =  1  ! max num coarse solver iterations      [1]
! ml_elliptic_opt % i_max =  1  ! max num multigrid iterations          [1]
! ml_elliptic_opt % ns_1  =  1  ! num pre-smoothing steps               [1]
! ml_elliptic_opt % ns_2  =  1  ! num post-smoothing steps              [1]
! ml_elliptic_opt % ns_c  =  1  ! num continuation smoothing steps      [1]
! ml_elliptic_opt % r_red = -1  ! min residual reduction                [-1]
! ml_elliptic_opt % r_max = -1  ! max admissible residual               [-1]

/
