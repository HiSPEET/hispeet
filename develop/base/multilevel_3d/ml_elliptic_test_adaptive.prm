&control_prm
! log_level = 0
! log_level_inner_iteration = 0
! log_level_outer_iteration = 0
! log_level_multigrid_cycle = 1
  export_vtk = T
/

! test_domain = 0
&domain_prm
! gmsh_file = '../gmsh_3d/cylinder_2d'
/

! test_domain = 1
&cuboid_cartesian_prm
  xo = 3*0.0
  lx = 3*1.0
  np = 1,1,1
  ep = 2,2,2
/

&ml_mesh_options_3d__static
  l_top          =  4  ! initial top level
  l_max          =  8  ! ultimate top level
  l_adapt        =  5  ! first level to be adapted ≥ 1
  n_parts_root   =  1  ! number of partitions at root level   [1]
  n_parts_growth =  2  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 3*'c', 4*'s' ! (1:l_max-1)  refinement type {'c','s'}
/

&problem_prm
  lambda       = 0   ! Helmholtz parameter
  alpha        = 200 ! radial scaling factor 
  start_values = 0   ! start values, 0/1/2: zero, exact, random
/

&solver_prm
  n_cycle = 7

  po = 1, 2, 4, 5*8 ! (1:l_max)

! ml_elliptic_opt%penalty         =  2.0   ! penalty parameter > 1   [2]
  ml_elliptic_opt%schwarz%delta   =  0.125 ! relative overlap  ≤ 1   [?]
  ml_elliptic_opt%schwarz%no_min  =   1    ! min overlap in points   [?]
  ml_elliptic_opt%fc_projection   =  'I'   ! {'I','P'}               ['I']
  ml_elliptic_opt%start_method    =   0    ! none/CASC/FMG = 0/1/2   [2]
  ml_elliptic_opt%smooth_method   =   3    ! CG/WS/SPCG    = 1/2,3   [2]
  ml_elliptic_opt%coarse_solver   =   3    ! CG/WS/SPCG    = 1/2,3   [3]

  ml_elliptic_opt%i_crs =  100 ! max num coarse solver iterations    [1]
  ml_elliptic_opt%i_max =    4 ! max num multigrid iterations        [1]
  ml_elliptic_opt%ns_1  =    2 ! num pre-smoothing steps             [1]
  ml_elliptic_opt%ns_2  =    2 ! num post-smoothing steps            [1]
  ml_elliptic_opt%ns_c  =    2 ! num continuation smoothing steps    [1]
! ml_elliptic_opt%r_red =   -1 ! min residual reduction              [-1]
! ml_elliptic_opt%r_max =   -1 ! max admissible residual             [-1]

/

&adaptation_prm
  adapt_criterion = 3
  adapt_remove    = 0
  adapt_refine    = 1E-2
/
