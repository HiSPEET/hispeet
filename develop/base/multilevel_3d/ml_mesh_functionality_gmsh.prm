&control
  log_level  = 0
  domain     = 0
  gmsh_file  = '../../gmsh/cylinder_2d'
  vtk_export = F
  restart    = T
/

&ml_mesh_options_3d__static
  l_top          =  4
  l_adapt        =  1
  n_bnd          =  1
  n_box          =  1
! split          =  T
  n_parts_root   =  2
  n_parts_growth =  2
  n_con_root     =  4
  n_con_child    =  3
/

&ml_mesh_options_3d__dynamic
  refinement          = 'c','c','s'      ! (l_top-1)   {'c','s'}
  adapt_bnd(1:1)      =  7               ! (n_bnd)
  adapt_box(1:3,1,1)  =  0.0, -0.05, -1  ! (1:3,1,*)
  adapt_box(1:3,2,1)  =  1.0,  0.05,  1  ! (1:3,2,*)
  
/

&operators
  po = 1, 2, 4, 4
/
