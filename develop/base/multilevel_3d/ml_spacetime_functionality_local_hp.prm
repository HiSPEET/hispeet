&control
! log_level = 0
! gmsh_file = '../gmsh_3d/cylinder_2d'
/

&ml_mesh_options_3d__static
  l_top          =  4
  l_adapt        =  1
  n_bnd          =  1
  n_box          =  1
  n_parts_root   =  1
  n_parts_growth =  2
/

&ml_mesh_options_3d__dynamic
  refinement          = 'c','c','s'     ! (l_top-1)   {'c','s'}
  adapt_bnd(1:1)      =  7              ! (n_bnd)
  adapt_box(1:3,1,1)  =  0.1, 0, -1     ! box 1
  adapt_box(1:3,2,1)  =  1.0, 0,  1     ! 
  adapt_tol           =  .12, .04, .02  ! (l_top-1)
/

&discretization
  po_x = 1, 2, 4, 4
  po_t = 0, 1, 2, 4
  ne_t = 1, 1, 1, 1
! nodes_t = 'RR'
! smooth  = 0
  dt_slab = 0.05
/
