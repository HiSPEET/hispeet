! run with
! $MPIRUN -n 1 ml_elliptic_test_static ml_elliptic_test_static_global-h
! $MPIRUN -n 6 ml_elliptic_test_static ml_elliptic_test_static_global-h

&control_prm
! log_level = 2
! log_level_inner_iteration = 0
! log_level_outer_iteration = 1
! log_level_multigrid_cycle = 1

  solution_method = 12 ! 11/12/20: CS-MG/CS-MGCG/FAS-MG   [12]
! check_hdf5 = T
! export_vtk = T
/

&domain_prm
! test_domain = 1
! gmsh_file   = '../gmsh_3d/cylinder_2d'
/

! test_domain = 1
&cuboid_cartesian_prm
! regular    = F ! mimic deformed mesh
! structured = F ! mimic unstructured mesh

! problems 1:4
! set lx(2:3) to to 2π×AR for integer aspect ratio AR ≥ 1
! lx(2:3) = 2*1.2566370614359172953760D+1  ! AR =  2
! lx(2:3) = 2*2.5132741228718345907520D+1  ! AR =  4
! lx(2:3) = 2*5.0265482457436691815040D+1  ! AR =  8
! lx(2:3) = 2*1.0053096491487338363008D+2  ! AR = 16
! lx(2:3) = 2*2.0106192982974676726016D+2  ! AR = 32
  np = 1,1,1
  ep = 2,2,2
  periodic = 3*T

! problem 5 (TGV pressure)
! xo = 3*-0.5
! lx = 3*1.0
! np = 1,1,1
! ep = 2,2,2

! problem 6 (sphere)
! xo = 3*0.0
! lx = 3*1.0
! np = 1,1,1
! ep = 2,2,2
/

! test_domain = 2
&cuboid_diamonds_prm
/

! config = 4
&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 3
  pg = 7
/

&ml_mesh_options_3d__static
  l_top          = 4  ! top level                            [1]
  l_max          = 4  ! max number of levels                 [1]
  n_parts_root   = 1  ! number of partitions at root level   [1]
  n_parts_growth = 2  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 3*'s' ! (1:l_max-1)  refinement type {'c','s'}
/

&problem_prm
  test_problem = 3
  lambda       = 0  ! Helmholtz parameter
! nu_0         = 1  ! diffusivity mean value ν₀
! nu_1         = 0  ! diffusivity fluctuation amplitude ν₁ ! only problems 1:5
  alpha        = 10 ! radial scaling factor                ! only problem  6   (sphere)
  start_values = 0  ! start values, 0/1/2: zero, exact, random
! bc = 6*'N'
/

&solver_prm

  po = 8, 8, 8, 8

! ml_elliptic_opt%penalty        =  2.0   ! penalty parameter > 1    [2]
  ml_elliptic_opt%schwarz%delta  =  0.125 ! relative overlap  ≤ 1    [?]
  ml_elliptic_opt%schwarz%no_min =   1    ! min overlap in points    [?]
  ml_elliptic_opt%fc_projection  =  'I'   ! {'I','P'}                ['I']
  ml_elliptic_opt%start_method   =   1    ! none/CASC/FMG = 0/1/2    [2]
  ml_elliptic_opt%smooth_method  =   3    ! CG/WS/SPCG    = 1/2,3    [2]
  ml_elliptic_opt%coarse_solver  =   3    ! CG/WS/SPCG    = 1/2,3    [3]

  ml_elliptic_opt%i_crs =  1000 ! max num coarse solver iterations   [1]
  ml_elliptic_opt%i_max =   500 ! max num multigrid iterations       [1]
  ml_elliptic_opt%ns_1  =     2 ! num pre-smoothing steps            [1]
  ml_elliptic_opt%ns_2  =     2 ! num post-smoothing steps           [1]
  ml_elliptic_opt%ns_c  =     2 ! num continuation smoothing steps   [1]
  ml_elliptic_opt%r_red = 1e-10 ! min residual reduction             [-1]
  ml_elliptic_opt%r_max = 1e-12 ! max admissible residual            [-1]

/
