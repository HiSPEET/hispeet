!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
  log_level_multigrid_cycle = 1

  problem_file = 'channel'
  flow_problem = 'Channel'
  flow_domain  = 1
  refinement_strategy = 'L'

! char_freq  = 0 ! set frequency of control output
! avg_rate   = 1 ! sampling rate for averaging, 0 if none
! vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs

! restart_tag_in  = 'run1'
! restart_tag_out = 'run1'
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  5  ! initial top level
  l_max          =  5  ! initial top level
  l_adapt        =  3  ! first level to be adapted > 1
  n_bnd          =  2  ! number of boundaries to be adapted
/

&ml_mesh_options_3d__dynamic
  n_parts    = 5*8
  refinement = 2*'c',2*'s'
  adapt_bnd  = 5, 6
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 2, 4, 3*8

! ml_ins_opt%ins%stokes_corrector = 'X2PD'
! ml_ins_opt%ml_solver_p
  ml_ins_opt%ins%c_mu = 1
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

! ml_bdf2_opt%n_fmg = 0
  ml_bdf2_opt%n_cyc = 1

! t_end  = 0.25
  dt     = 0.001
  nt_max = 10!1000000
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  lx(1) = 12.56637061435917295376   ! streamwise:   4π  
  lx(2) = 4.18879020478639098458    ! spanwise:     4π/3
  lx(3) = 2                         ! wall-normal:  2δ,   δ = 1
  np = 3*1
  ep = 3*4
  periodic = T,T,F
/
