!===============================================================================
! FAS MG with global hp-refinement and simple pressure smoothing

!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
! log_level_multigrid_cycle = 1

  problem_file  = 'cylinder_2d'
  flow_problem  = 'Cylinder2D'
  flow_domain   =  10
  raw_mesh_file = '../../../gmsh/cylinder_2d'

  char_freq  =  1 ! set frequency of control output
  flux_freq  =  5 ! set frequency of control output
! avg_rate   =  1 ! sampling rate for averaging, 0 if none
! vtk_mode   =  3 ! VTK export mode, 0/1/2/3: none/all/active/leafs

! restart_tag_in  = 'run1'
! restart_tag_out = 'run1'
! restart_adjust  = T
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top   = 5  ! initial top level
  l_max   = 5  ! maximum top level
  l_adapt = 3
  n_bnd   = 1
  n_box   = 1
/

&ml_mesh_options_3d__dynamic
  n_parts            = 3*13, 39, 78    ! 156 elements in total
  refinement         = 2*'c',2*'s'     ! (1:l_max-1) refinement type {'c','s'}
  adapt_bnd(1:1)     = 3               ! (n_bnd)
  adapt_box(1:3,1,1) = 0.2, 0.15, -1  ! (1:3,1,*)
  adapt_box(1:3,2,1) = 1.2, 0.25,  1  ! (1:3,2,*)
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 2 3 7 7 7

  ml_ins_opt%mixed = F

  ml_ins_opt%ins_op%diffusion_solver = 'SPCG'  ! {'DPCG','SPCG'}
  ml_ins_opt%ins_op%mu_0             = 0.1
  ml_ins_opt%ins_op%div_stab         = 5
    !!  - `1`  constant, μ₁ = μ₀
    !!  - `2`  constant, μ₂ = μ₀ max(ν, vh), using reference values for ν and v
    !!  - `3`  variable, μ₃ = μ₀ max(ν, vh), using element averages for ν and v
    !!  - `4`  variable, μ₄ = μ₂ averaged across faces
    !!  - `5`  variable, μ₅ = μ₃ averaged across faces

  ml_ins_opt%ins_op%dealiasing       = T
  ml_ins_opt%ins_op%penalty_p        = 10
  ml_ins_opt%ins_op%schwarz_u%delta  = 0.04
  ml_ins_opt%ins_op%schwarz_p%delta  = 0.04
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 5e-2
  dt     = 1e-3
  nt_max = 100000

  ml_bdf_opt%projection%p_solver%smooth_method = 3
  ml_bdf_opt%projection%p_solver%i_crs = 10000 ! max num coarse iterations          [ 1]
  ml_bdf_opt%projection%p_solver%i_max =    20 ! max num cycles                     [ 1]
  ml_bdf_opt%projection%p_solver%ns_1  =     6 ! num pre-smoothing steps            [ 1]
  ml_bdf_opt%projection%p_solver%ns_2  =     2 ! num post-smoothing steps           [ 1]
  ml_bdf_opt%projection%p_solver%ns_c  =     4 ! num continuation smoothing steps   [ 1]
  ml_bdf_opt%projection%p_solver%r_red = 1e-10 ! min residual reduction,  if > 0    [-1]
  ml_bdf_opt%projection%p_solver%r_max = 1e-12 ! max admissible residual, if > 0    [-1]

  ml_bdf_opt%diffusion%i_max =    10 ! max num cycles
  ml_bdf_opt%diffusion%ns_1  =     6 ! num pre-smoothing steps
  ml_bdf_opt%diffusion%ns_2  =     2 ! num post-smoothing steps
  ml_bdf_opt%diffusion%ns_c  =     4 ! num continuation smoothing steps
  ml_bdf_opt%diffusion%i_crs =    20 ! num continuation smoothing steps
  ml_bdf_opt%diffusion%r_crs = 1e-10 ! num continuation smoothing steps
  ml_bdf_opt%diffusion%r_red = 1e-10 ! num continuation smoothing steps
  ml_bdf_opt%diffusion%r_max = 1e-12 ! num continuation smoothing steps
/
