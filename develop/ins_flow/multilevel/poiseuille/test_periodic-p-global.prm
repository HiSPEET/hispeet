!===============================================================================
! FAS MG with global p-refinement and simple pressure smoothing

!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity
! log_level_multigrid_cycle = 1  !

  problem_file = 'poiseuille_periodic'
  flow_problem = 'Poiseuille'
  flow_domain  = 1

! char_freq  = 0 ! set frequency of control output
! vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  3  ! initial top level
  n_parts_root   =  8  ! number of partitions at root level   [1]
  n_parts_growth =  8  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 2*'c' ! (1:l_top-1)  refinement type {'c','s'}
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 2 4 8

! ml_ins_opt%mixed = F

  ml_ins_opt%pressure%i_crs =  1000 ! max num coarse iterations          [ 1]
  ml_ins_opt%pressure%i_max =    10 ! max num cycles                     [ 1]
  ml_ins_opt%pressure%ns_1  =     1 ! num pre-smoothing steps            [ 1] 
  ml_ins_opt%pressure%ns_2  =     1 ! num post-smoothing steps           [ 1] 
  ml_ins_opt%pressure%ns_c  =     1 ! num continuation smoothing steps   [ 1] 
  ml_ins_opt%pressure%r_red = 1e-10 ! min residual reduction,  if > 0    [-1] 
  ml_ins_opt%pressure%r_max = 1e-12 ! max admissible residual, if > 0    [-1] 

  ml_ins_opt%diffusion%i_max =    2 ! max num cycles                     [ 1]
  ml_ins_opt%diffusion%ns_1  =    3 ! num pre-smoothing steps            [ 1] 
  ml_ins_opt%diffusion%ns_2  =    1 ! num post-smoothing steps           [ 1] 
  ml_ins_opt%diffusion%ns_c  =    2 ! num continuation smoothing steps   [ 1] 

! ml_ins_opt%ins_op%diffusion_solver = 'SPCG'
! ml_ins_opt%ins_op%mu_0 = 1

  ml_ins_opt%ins_op%dealiasing = T
  ml_ins_opt%ins_op%i_max_v    = 20
  ml_ins_opt%ins_op%r_red      = 1e-10
  ml_ins_opt%ins_op%r_max      = 1e-12
/
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.01
  dt     = 1e-4
  nt_max = 10000
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  xo = 0.0, 0.0, 0.00
  lx = 2.0, 2.0, 0.25
  periodic = T,F,T

! for serial runs
  np =  1,1,1
  ep =  8,8,1
/
