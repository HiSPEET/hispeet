!===============================================================================
! FAS MG with global p-refinement and simple pressure smoothing

!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'poiseuille_periodic'
  flow_problem = 'Poiseuille'
  flow_domain  = 1

! char_freq  = 0 ! set frequency of control output
! vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  3  ! initial top level
  n_parts_root   =  8  ! number of partitions at root level   [1]
  n_parts_growth =  8  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 2*'c' ! (1:l_top-1)  refinement type {'c','s'}
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 2 4 8

! ml_ins_opt%ins%c_mu    = 1
  ml_ins_opt%ins%i_max_p = 5
  ml_ins_opt%ins%i_max_v = 5

! use these for segregated pressure-diffusion solver
! ins_op_opt%i_max_p  = 10000
! ins_op_opt%i_max_v  = 100
! ins_op_opt%r_red    = 1e-10
! ins_op_opt%r_max    = 1e-12
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  ml_bdf2_opt%n_fmg = 1
  ml_bdf2_opt%n_cyc = 1

  t_end  = 1
  dt     = 1e-4
  nt_max = 10!000
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  xo = 0.0, 0.0, 0.00
  lx = 2.0, 2.0, 0.25
  periodic = T,F,T

! for serial runs
  np =  1,1,1
  ep =  8,8,1

! for parallel runs
! np =  2,2,1
! ep =  4,4,1
/
