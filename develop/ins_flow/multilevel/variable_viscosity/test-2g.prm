!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
  log_level_inner_iteration = 1
  log_level_outer_iteration = 1
  log_level_multigrid_cycle = 1

  problem_file = 'variable_viscosity'
  flow_problem = 'VariableViscosity'
  flow_domain  = 1

! char_freq  = 0 ! set frequency of control output
  vtk_mode   = 1 ! VTK export mode, 0/1/2/3: none/all/active/leafs
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  2  ! initial top level
  l_max          =  5  ! max top level
  n_parts_root   =  8  ! number of partitions at root level   [1]
  n_parts_growth =  8  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 3*'c', 1*'s' ! (1:l_max-1)  refinement type {'c','s'}
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

! po = 16
  po = 7 15

  ml_ins_opt%mixed = T
  ml_ins_opt%fc_project ='I'
! ml_ins_opt%ins%mu_0 = 1
! ml_ins_opt%ins%i_max_p =  0
  ml_ins_opt%ins%i_max_v =  10
  ml_ins_opt%ins%r_red   =  1e-12
  ml_ins_opt%ins%r_max   =  1e-14

/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  ml_bdf2_opt%n_fmg = 0
  ml_bdf2_opt%n_cyc = 8

  t_end  = 0.25
  dt     = 0.001
  nt_max = 5!10!00000
/

!-------------------------------------------------------------------------------
! Domains

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo = 3*-0.5
  lx = 3*1
  np = 1,1,1
  ep = 3*1
  periodic = 3*T
/
