!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
  log_level_inner_iteration = 2
! log_level_outer_iteration = 1
  log_level_multigrid_cycle = 1

  problem_file = 'variable_viscosity'
  flow_problem = 'VariableViscosity'

  vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  1  ! initial top level
  n_parts_root   =  8  ! number of partitions at root level   [1]
  n_parts_growth =  8  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
! refinement = 'c','s'
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 16 !,1 2*16

! ml_ins_opt%mixed = F

  ml_ins_opt%ins_op%diffusion_solver = 'SPCG'
  ml_ins_opt%ins_op%mu_0 = 0

! ml_diff_opt%i_crs =    20 ! max num cycles                     [20]
  ml_diff_opt%i_max =     1 ! max num cycles                     [ 1]
  ml_diff_opt%ns_1  =     3 ! num pre-smoothing steps            [ 1] 
  ml_diff_opt%ns_2  =     1 ! num post-smoothing steps           [ 1] 
  ml_diff_opt%ns_c  =     2 ! num continuation smoothing steps   [ 1] 
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  dt = 1
/

!-------------------------------------------------------------------------------
! Disturbance

&disturbance_prm
  x_w = 3*-0.5
  l_w = 3*1.0
/

!-------------------------------------------------------------------------------
! Domains

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo = 3*-0.5
  lx = 3*1
  np = 1,1,1
  ep = 3*2
  periodic = 3*T
/
