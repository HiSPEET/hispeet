!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
! log_level_multigrid_cycle = 1

  problem_file = 'hagen_poiseuille'
  flow_problem = 'HagenPoiseuille'
  flow_domain  = 3

! char_freq  = 0 ! set frequency of control output
! avg_rate   = 1 ! sampling rate for averaging, 0 if none
  vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs

! restart_tag_in  = 'run1'
! restart_tag_out = 'run1'
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  4  ! initial top level
  l_max          =  4  ! initial top level
  l_adapt        =  2  ! first level to be adapted > 1
  n_bnd          =  1  ! number of boundaries to be adapted
  n_parts_root   = 12  ! number of partitions at root level   [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 1*'c', 2*'s' ! (1:l_top-1)  refinement type {'c','s'}
  adapt_bnd  = 1             ! adapt elements adjacent to the wall
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 4 8 8 8

  ml_ins_opt%mixed = F

  ml_ins_opt%pressure%i_crs =  1000 ! max num coarse iterations          [ 1]
  ml_ins_opt%pressure%i_max =    10 ! max num cycles                     [ 1]
  ml_ins_opt%pressure%ns_1  =     6 ! num pre-smoothing steps            [ 1] 
  ml_ins_opt%pressure%ns_2  =     2 ! num post-smoothing steps           [ 1] 
  ml_ins_opt%pressure%ns_c  =     4 ! num continuation smoothing steps   [ 1] 
  ml_ins_opt%pressure%r_red = 1e-10 ! min residual reduction,  if > 0    [-1] 
  ml_ins_opt%pressure%r_max = 1e-12 ! max admissible residual, if > 0    [-1] 

  ml_ins_opt%diffusion%i_max =    4 ! max num cycles                     [ 1]
  ml_ins_opt%diffusion%ns_1  =    3 ! num pre-smoothing steps            [ 1] 
  ml_ins_opt%diffusion%ns_2  =    1 ! num post-smoothing steps           [ 1] 
  ml_ins_opt%diffusion%ns_c  =    2 ! num continuation smoothing steps   [ 1] 

  ml_ins_opt%ins_op%diffusion_solver = 'SPCG'
  ml_ins_opt%ins_op%c_mu = 0.01

! ml_ins_opt%ins_op%dealiasing = T
! ml_ins_opt%ins_op%penalty_u  = 10
  ml_ins_opt%ins_op%penalty_p  = 10
  ml_ins_opt%ins_op%i_max_v    = 20
  ml_ins_opt%ins_op%r_red      = 1e-10
  ml_ins_opt%ins_op%r_max      = 1e-12
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.1
  dt     = 1e-4
  nt_max = 10000
/

!-------------------------------------------------------------------------------
! Domain

! flow_domain = 3: pipe with radius r = 1 and length h
&cylinder_prm
  r  = 1.0
  h  = 2.0
  nr = 2
  nz = 3
  pg = 15
  periodic = T
/
