!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
! log_level_multigrid_cycle = 1

  problem_file = 'hagen_poiseuille'
  flow_problem = 'HagenPoiseuille'
  flow_domain  = 3

! char_freq  = 0 ! set frequency of control output
! vtk_mode   = 3 ! VTK export mode, 0/1/2/3: none/all/active/leafs
/

!-------------------------------------------------------------------------------
! Mesh

&ml_mesh_options_3d__static
  l_top          =  1  ! initial top level
  l_max          =  1  ! initial top level
  n_parts_root   =  1  ! number of partitions at root level   [1]
/

&ml_mesh_options_3d__dynamic
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po = 7

! ml_ins_opt%mixed = F

  ml_ins_opt%pressure%i_crs =  1000 ! max num coarse iterations          [ 1]
  ml_ins_opt%pressure%i_max =    10 ! max num cycles                     [ 1]
  ml_ins_opt%pressure%ns_1  =     1 ! num pre-smoothing steps            [ 1] 
  ml_ins_opt%pressure%ns_2  =     1 ! num post-smoothing steps           [ 1] 
  ml_ins_opt%pressure%ns_c  =     1 ! num continuation smoothing steps   [ 1] 
  ml_ins_opt%pressure%r_red = 1e-10 ! min residual reduction,  if > 0    [-1] 
  ml_ins_opt%pressure%r_max = 1e-12 ! max admissible residual, if > 0    [-1] 

! ml_ins_opt%ins_op%diffusion_solver = 'SPCG'
! ml_ins_opt%ins_op%c_mu = 1

  ml_ins_opt%ins_op%dealiasing = T
  ml_ins_opt%ins_op%i_max_v    = 20
  ml_ins_opt%ins_op%r_red      = 1e-10
  ml_ins_opt%ins_op%r_max      = 1e-12
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.1
  dt     = 1e-3
  nt_max = 100!0000
/

!-------------------------------------------------------------------------------
! Domain

! flow_domain = 3: pipe with radius r = 1 and length h
&cylinder_prm
  r  = 1.0
  h  = 2.0
  nr = 2
  nz = 2
  pg = 15
  periodic = T
/
