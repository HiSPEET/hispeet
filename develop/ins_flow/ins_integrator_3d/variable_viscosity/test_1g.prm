!-------------------------------------------------------------------------------
! Control

&control_prm

! log levels,  set to ≥ 1 for higher verbosity
! log_level                 = 0
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1

  problem_file = 'variable_viscosity'
  flow_problem = 'VariableViscosity'
  flow_domain  = 1

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 16
  po_p = 15

  ins_op_opt%dealiasing = T

  ! the following parameters needs further consideration

  ins_op_opt%mu_0       = 1     ! increase: smaller divergence, more iterations
  ins_op_opt%i_max_p    = 1000  ! increase: better robustness, more cost
  ins_op_opt%i_max_v    = 20    ! increase: smaller divergence, more cost
  ins_op_opt%r_red      = 1e-12
  ins_op_opt%r_max      = 1e-14
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 0.25
  dt     = 0.0001
  nt_max = 10!00000

  time_method = 2  ! 1/2/3: Euler/BDF/Runge-Kutta

                              ! ARS443    CB3e
  ins_ti_rk_opt%n_stage  = 5  !   5        4
  ins_ti_rk_opt%method   = 1  !   1        2
/

!-------------------------------------------------------------------------------
! Domains

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo = 3*-0.5
  lx = 3*1
  np = 1,1,1
  ep = 3*4
! periodic = 3*T
/
