!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'stokes_dkm'
  flow_problem = 'Stokes_DKM'
  flow_domain  = 1

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm
  ins_op_opt%dealiasing       = F
  ins_op_opt%div_stab         = 1
  ins_op_opt%mu_0             = 1
  ins_op_opt%diffusion_solver = 'DPCG'
  ins_op_opt%i_max_p          = 10000
  ins_op_opt%i_max_v          = 20

! equal order  !  k=1   k=2   k=3   k=4
! po_u = 3     !   1     2     3     4
! po_p = 3     !   1     2     3     4

! mixed order  !  k=1   k=2   k=3   k=4
  po_u = 4     !   2     3     4     5
  po_p = 3     !   1     2     3     4
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 0.1
  dt     = 1e-4
  nt_max = 10000

  time_method = 2  ! 1/2 Euler/BDF
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm

! k = 1
! xo = -1,-1,-0.125
! lx =  2, 2, 0.250
! np =  1, 1, 1
! ep =  8, 8, 1

! k = 2
! xo = -1,-1,-0.25
! lx =  2, 2, 0.50
! np =  1, 1, 1
! ep =  4, 4, 1

! k = 3
  xo = -1,-1,-0.5
  lx =  2, 2, 1.0
  np =  1, 1, 1
  ep =  2, 2, 1

! k = 4
! xo = -1,-1,-1
! lx =  2, 2, 2
! np =  1, 1, 1
! ep =  1, 1, 1

  periodic = F,F,T
/
