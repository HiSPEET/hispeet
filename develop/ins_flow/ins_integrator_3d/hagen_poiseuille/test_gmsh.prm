!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file  = 'hagen_poiseuille'
  flow_problem  = 'HagenPoiseuille'
  flow_domain   =  10
  raw_mesh_file = '../../../gmsh/pipe'

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm
  po_u = 7
  po_p = 7

! ins_op_opt%penalty_u =   10
  ins_op_opt%penalty_p =   10
  ins_op_opt%div_stab  =    1
  ins_op_opt%mu_0      =    1
  ins_op_opt%i_max_v   =   20
  ins_op_opt%i_max_p   = 1000
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.1
  dt     = 1e-3
  nt_max = 100!0

  time_method = 2  ! 1/2 Euler/BDF
/

