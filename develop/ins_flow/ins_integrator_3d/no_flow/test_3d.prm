!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'no_flow_3d'
  flow_problem = 'NoFlow'
  flow_domain  = 1

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 3
  po_p = 2

  ins_op_opt%dealiasing       = F
  ins_op_opt%c_mu             = 10000
  ins_op_opt%diffusion_solver = 'DPCG'
  ins_op_opt%i_max_p          = 10000
  ins_op_opt%i_max_v          = 20
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 1
  dt     = 1e-4
  nt_max = 10000

  time_method = 2  ! BDF
/

!-------------------------------------------------------------------------------
! Domain

! flow_domain  =  1
&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (deformed elements)
  structured = F ! mimic unstructured mesh
  xo = 0.0, 0.0, 0.0
  lx = 1.0, 1.0, 1.0
  periodic = F,F,F

! for serial runs
  np =  3*1  ! use for
  ep =  3*2  ! serial runs

! for parallel runs
! np = 3*4
! ep = 3*3
/
