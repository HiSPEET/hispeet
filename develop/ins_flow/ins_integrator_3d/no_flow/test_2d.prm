!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 2  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'no_flow_2d'
  flow_problem = 'NoFlow'
  flow_domain  = 1

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 3
  po_p = 2

  ins_op_opt%dealiasing       = F
  ins_op_opt%div_stab         = 1
  ins_op_opt%mu_0             = 10000
  ins_op_opt%diffusion_solver = 'DPCG'
  ins_op_opt%i_max_p          = 10000
  ins_op_opt%i_max_v          = 20
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 1
  dt     = 1e-4
  nt_max = 100!00

  time_method = 2  ! BDF
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  regular    = T ! mimic irregular mesh (deformed elements)
  structured = T ! mimic unstructured mesh
  xo = 0.0, 0.0, 0.000
  lx = 1.0, 1.0, 0.03125
  periodic = F,F,T

! for serial runs
  np = 2*1 , 1
  ep = 2*32, 1

! for parallel runs
! np = 2*8 , 1
! ep = 2*4 , 1
/
