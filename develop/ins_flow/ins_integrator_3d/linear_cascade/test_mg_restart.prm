!===============================================================================
! Copy this file to 'test_mg.prm' before use

!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
  log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity
! log_level_multigrid_cycle = 1  !

  problem_file  = 'linear_cascade'
  flow_problem  = 'LinearCascade'
  flow_domain   =  10
  raw_mesh_file = '../../../gmsh/linear_cascade'

! vtk_export   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output

  restart_tag_in  = 'run1'
! restart_tag_out = 'run2'
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 4
  po_p = 1 2 3

  ins_op_opt%dealiasing       = T
  ins_op_opt%c_mu             = 1
  ins_op_opt%pressure_solver  = 'MGCG'
  ins_op_opt%diffusion_solver = 'DPCG'
  ins_op_opt%i_max_v          = 40

  ! multilevel pressure solver
  ml_solver_p_opt%smooth_method = 3          ! default, works fine now
  ml_solver_p_opt%i_crs = 1000
  ml_solver_p_opt%i_max = 5
  ml_solver_p_opt%ns_1  = 2                  ! can be reduced after start-up
  ml_solver_p_opt%ns_2  = 2                  ! can be reduced after start-up
  ml_solver_p_opt%r_red = 1e-08
  ml_solver_p_opt%r_max = 1e-12

/

&ml_mesh_options_3d__static
  l_top          =  3  ! initial top level
  n_parts_root   =  8  ! number of partitions at root level   [1]
  n_parts_growth =  8  ! partition number growth rate         [1]
/

&ml_mesh_options_3d__dynamic
  refinement = 2*'c' ! (1:l_max-1)  refinement type {'c','s'}
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.25
  dt     = 1e-4
  nt_max = 1000
! smooth_initial_data = T                     ! not used for restart

  time_method = 2  ! BDF
/
