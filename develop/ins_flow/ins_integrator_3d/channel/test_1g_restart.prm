!===============================================================================
! Copy this file to 'test_1g.prm' before use

!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 =  1  ! activate/increase
! log_level_inner_iteration =  1  ! for higher
! log_level_outer_iteration =  1  ! verbosity

  problem_file =  'channel'
  flow_problem =  'Channel'
  flow_domain  =  1

  eval_diss    =  T
! vtk_export   =  T  ! set T for generating plot files
  char_freq    = 10  ! set frequency of control output

  restart_tag_in  = 'run1'
  restart_tag_out = 'run2'
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 8
  po_p = 7

  ins_op_opt%dealiasing = T
  ins_op_opt%div_stab   = 1
  ins_op_opt%mu_0       = 1
  ins_op_opt%penalty_u  = 10

  ins_op_opt%i_max_p  = 50000
  ins_op_opt%i_max_v  = 50

  ins_op_opt%sgs_model%model    = 2      ! [0]
! ins_op_opt%sgs_model%smooth   = 0      ! [2]
! ins_op_opt%sgs_model%dynamic  = F      ! [T]
! ins_op_opt%sgs_model%c_static = 1.35   ! [1.35]
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 0.25
  dt     = 1e-4
  nt_max = 900

  time_method = 2  ! 1/2/3: Euler/BDF/Runge-Kutta
/

!-------------------------------------------------------------------------------
! Domains

&cuboid_cartesian_prm
  xo    =  3*0.0
  lx(1) =  6.28318530717958647688d+0   ! 2πδ
  lx(2) =  3.14159265358979323844d+0   ! πδ
  lx(3) =  2.0                         ! 2δ

  np =  1,1,1  ! num partitions per direction             ! small mesh for
  ep =  8,8,8  ! num elements per direction and partition ! for playing around

! np =  4,4,8  ! num partitions per direction             ! large mesh for
! ep =  6,6,3  ! num elements per direction and partition ! real study

  periodic = T,T,F
/
