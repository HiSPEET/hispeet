!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'stokes_linke'
  flow_problem = 'Stokes_Linke'
  flow_domain  = 1

! export_vtk   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 4
  po_p = 3

  ins_op_opt%dealiasing = F
  ins_op_opt%mu_0       = 1

! use these for coupled pressure-diffusion Krylov solver
! ins_op_opt%i_max_p  = 1000
! ins_op_opt%i_max_v  = 1000
! ins_op_opt%k_max    = 4
! ins_op_opt%k_pre_p  = 200
! ins_op_opt%k_pre_v  = 200

! use these for segregated pressure-diffusion solver
  ins_op_opt%i_max_p  = 10000
  ins_op_opt%i_max_v  = 10000
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 1
  dt     = 1e-5
  nt_max = 10000

  time_method = 1  ! 1/2 Euler/BDF
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  xo = 0, 0, 0.000
  lx = 1, 1, 0.250
  np = 1, 1, 1
  ep = 4, 4, 1
  periodic = F,F,T
/
