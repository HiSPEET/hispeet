!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'vortex_tg'
  flow_problem = 'Vortex_TG'
  flow_domain  = 1

! export_vtk   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 10
  po_p =  9

  ins_op_opt%pressure_method  = 3
  ins_op_opt%diffusion_method = 3
  ins_op_opt%penalty          = 20
  ins_op_opt%dealiasing       = T

  ! bulk viscosity
  !   - use μ = 0 for Stokes hypothesis
  !   - use μ = ν for grad-div stabilization in diffusion dominant case
  !   - use μ ~ √(ν² + v²h²) for stabilization in convection dominant case
  ins_op_opt%mu_0 = 0.0

  ! multilevel pressure solver
  ! ml_solver_p_opt % ..
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 0.05
  dt     = 0.005
  nt_max = 1000000

  time_method = 2  ! 1/2/3: Euler/BDF2/Runge-Kutta

  ! Euler options
  ins_ti_euler_opt%i_max_p = 1000
  ins_ti_euler_opt%i_max_v = 1000
  ins_ti_euler_opt%r_red   = 1e-12
  ins_ti_euler_opt%r_max   = 1e-14

  ! BDF2 options
  ins_ti_bdf2_opt%i_krylov = 0       ! set eg to 2 for trying GMRES
  ins_ti_bdf2_opt%i_max_p  = 1000
  ins_ti_bdf2_opt%i_max_v  = 1000
  ins_ti_bdf2_opt%i_pre_p  = 10
  ins_ti_bdf2_opt%i_pre_v  = 10
  ins_ti_bdf2_opt%r_red    = 1e-10
  ins_ti_bdf2_opt%r_max    = 1e-12

  ! Runge-Kutta options
  ins_ti_runge_kutta_opt%n_stage  = 5      ! 4 CB3e, 5 ARS443
  ins_ti_runge_kutta_opt%method   = 1      ! 2 CB3e, 1 ARS443
  ins_ti_runge_kutta_opt%i_max_p  = 1000
  ins_ti_runge_kutta_opt%i_max_v  = 1000
  ins_ti_runge_kutta_opt%r_red    = 1e-10
  ins_ti_runge_kutta_opt%r_max    = 1e-12
/

!-------------------------------------------------------------------------------
! Domains

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh

  xo = -0.5, -0.5,-0.125    ! low resolution
  lx =  1.0,  1.0, 0.25     !
  np =  1,1,1               !
  ep =  4,4,1               !

! xo = -0.5, -0.5, -0.0625  ! high resolution
! lx =  1.0,  1.0,  0.125   !
! np =  1,1,1               !
! ep =  8,8,1               !

  periodic = T,F,T
/
