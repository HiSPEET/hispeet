!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'poiseuille_periodic'
  flow_problem = 'Poiseuille'
  flow_domain  = 1

! export_vtk   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm
  po_u = 7
  po_p = 7

! one of these might be required with po_p = po_u - 1
! ins_op_opt%mu_0      = 1
! ins_op_opt%penalty_u = 20
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 1
  dt     = 1e-4
  nt_max = 10000

  time_method = 2  ! BDF2
  ins_ti_bdf2_opt%i_max_p  = 1000
  ins_ti_bdf2_opt%i_max_v  = 100
  ins_ti_bdf2_opt%r_red    = 1e-10
  ins_ti_bdf2_opt%r_max    = 1e-12
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  xo = 0.0, 0.0, 0.00
  lx = 2.0, 2.0, 0.25
  periodic = T,F,T

! for serial runs
  np =  1,1,1
  ep =  8,8,1

! for parallel runs
! np =  2,2,1
! ep =  4,4,1
/
