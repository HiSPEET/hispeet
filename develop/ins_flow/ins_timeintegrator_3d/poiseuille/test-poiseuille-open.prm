&control_prm
  flow_problem =  'Poiseuille'
  problem_file =  'poiseuille-open'
  flow_domain  =  1
  time_method  =  1   ! 1 Euler, 2 BDF2, 3 Runge-Kutta
!
! ins_op_opts%mu_0 =   1.0                                ! μ ≫ ν
! ins_op_opts%mu_0 =   0.016                              ! μ = √(ν² + v²h²)
! ins_op_opts%mu_0 =   0.01                               ! μ = ν
! ins_op_opts%mu_0 =   6.6666666666666666666666666666D-3  ! χ = μ - 2ν/3 = 0
  ins_op_opts%mu_0 =   0.0                                ! μ = 0
! ins_op_opts%mu_0 =  -3.3333333333333333333333333333D-3  ! laplacian
! ins_op_opts%mu_0 = -13.3333333333333333333333333333D-3  ! rotational

  ins_op_opts%eop_u%StandardElementOptions_1D%po =  7
  ins_op_opts%eop_u%penalty                       = 20
  ins_op_opts%eop_p%StandardElementOptions_1D%po =  6
  ins_op_opts%eop_p%penalty                       = 20
  ins_op_opts%sop_q%po        = 11
  ins_op_opts%sop_q%nodes     = 'L'
  ins_op_opts%schwarz_p%delta = 0.25
  ins_op_opts%schwarz_u%delta = 0.25
!
! Euler options
  ins_ti_euler_opts%i_max_p = 1000
  ins_ti_euler_opts%i_max_v = 1000
  ins_ti_euler_opts%r_red   = 1e-12
  ins_ti_euler_opts%r_max   = 1e-14
!
! BDF2 options
  ins_ti_bdf2_opts%i_max_p  = 1000  ! 1000
  ins_ti_bdf2_opts%i_max_v  = 10    ! 1000
  ins_ti_bdf2_opts%r_red    = 1e-10 ! 1e-12
  ins_ti_bdf2_opts%r_max    = 1e-12 ! 1e-14
!
! Runge-Kutta options
!   n_stage   method      IMEX-RK
!      2        1         Euler
!      3        1         CB2
!      3        2         trapezoidal rule
!      4        1         CB3c
!      4        2         CB3e
!      5        1         ARS443
!      6        1         CB4
!      8        1         ARK5(4)8L[2]SA
  ins_ti_runge_kutta_opts%n_stage  = 5     ! 5
  ins_ti_runge_kutta_opts%method   = 1     ! 1
  ins_ti_runge_kutta_opts%i_max_p  = 1000  ! 1000
  ins_ti_runge_kutta_opts%i_max_v  = 10    ! 1000
  ins_ti_runge_kutta_opts%r_red    = 1e-10 ! 1e-12
  ins_ti_runge_kutta_opts%r_max    = 1e-12 ! 1e-14

  t_end  = 0.1
  dt     = 1e-3
  nt_max = 1!000
!
  export_vtk = T                 ! set T for generating plot files
! char_freq  = 2                 ! set to control frequency of control output
! log_level_inner_iteration = 1  ! set log level > 0 for higher verbosity
/

! flow_domain  =  1
&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo =  0.0, 0.0, 0.00
  lx =  2.0, 2.0, 0.25
! np =  2,2,1
! ep =  4,4,1
  np =  1,1,1
  ep =  8,8,1
! pg = 1
  periodic = F,F,T
/

! flow_domain = 2
&cuboid_diamonds_prm
! pg = 1
! periodic = F
/

! flow_domain = 3
&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 2
  pg = 15
! periodic = F
/

! flow_domain = 4
&annulus_prm
! pg = 3
! periodic = F
/
