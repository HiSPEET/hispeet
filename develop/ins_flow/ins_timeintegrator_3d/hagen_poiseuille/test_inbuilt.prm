!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file  = 'hagen_poiseuille'
  flow_problem  = 'HagenPoiseuille'
  flow_domain   =  3

! export_vtk   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm
  po_u = 7
  po_p = 7

  ins_op_opt%mu_0 = 1
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm
  t_end  = 0.1
  dt     = 1e-3
  nt_max = 10!00

  time_method = 2  ! 1/2 Euler/BDF2

  ! Euler options
  ins_ti_euler_opt%i_max_p  = 1000
  ins_ti_euler_opt%i_max_v  = 100
  ins_ti_euler_opt%r_red    = 1e-10
  ins_ti_euler_opt%r_max    = 1e-12

  ! BDF2 options
  ins_ti_bdf2_opt%i_max_p  = 1000
  ins_ti_bdf2_opt%i_max_v  = 100
  ins_ti_bdf2_opt%r_red    = 1e-10
  ins_ti_bdf2_opt%r_max    = 1e-12
/

!-------------------------------------------------------------------------------
! Domain

! flow_domain = 3: pipe with radius r = 1 and length h
&cylinder_prm
  r  = 1.0
  h  = 2.0
  nr = 2
  nz = 2
  pg = 15
  periodic = T
/
