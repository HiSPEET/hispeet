&control_prm
  flow_problem =  'Vortex_TG'
  problem_file =  'vortex_tg'
! flow_problem =  'VariableViscosity'
! problem_file =  'variable_viscosity'
  flow_domain  =  1
  time_method  =  1
! 
! ins_op_opts%mu_0 = 0
  ins_op_opts%eop_v%StandardOperatorOptions_1D%po = 15 ! %StandardOperatorOptions_1D
  ins_op_opts%eop_p%StandardOperatorOptions_1D%po = 14 ! required with ifort < 2021.7
  ins_op_opts%sop_q%po = 22
  ins_op_opts%sop_q%basis = 'L'
  ins_op_opts%schwarz_p%no = 3
  ins_op_opts%schwarz_v%no = 3
!
  ins_ti_euler_opts%i_max_p = 5
  ins_ti_euler_opts%i_max_v = 5
  ins_ti_euler_opts%r_red   = 1e-5
!
  ins_ti_bdf2_opts%i_max_p = 5
  ins_ti_bdf2_opts%i_max_v = 5
  ins_ti_bdf2_opts%r_red   = 1e-5
!
  t_end  = 0.1
  dt     = 1E-5
  nt_max = 1
!
  export_vtk = T
/

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo = 3*-0.5
  lx = 3*1
  np = 1,1,1
  ep = 3*2
! pg = 1
  periodic = 3*T
/

&cuboid_diamonds_prm
! pg = 1
! periodic = F
/

&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 2
  pg = 15
! periodic = F
/

&annulus_prm
! pg = 3
! periodic = F
/
