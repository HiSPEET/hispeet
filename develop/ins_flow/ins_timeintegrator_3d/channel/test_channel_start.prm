&control_prm
  flow_problem =  'Channel'
  problem_file =  'channel'
  flow_domain  =  1
  time_method  =  2   ! 1 Euler, 2 BDF2, 3 Runge-Kutta
!
! ins_op_opts%mu_0 =   0.0                                ! μ = 0
  ins_op_opts%mu_0 =   100                                ! μ = √(ν² + v²h²)

  ins_op_opts%eop_u%StandardElementOptions_1D%po =  8
  ins_op_opts%eop_u%penalty                      = 20
  ins_op_opts%eop_p%StandardElementOptions_1D%po =  7
  ins_op_opts%eop_p%penalty                      = 20
  ins_op_opts%sop_q%po        = 12
  ins_op_opts%sop_q%nodes     = 'L'
  ins_op_opts%schwarz_p%delta = 0.25
  ins_op_opts%schwarz_v%delta = 0.25
!
! BDF2 options
  ins_ti_bdf2_opts%i_max_p  = 50000 ! 1000
  ins_ti_bdf2_opts%i_max_v  = 50000 ! 1000
  ins_ti_bdf2_opts%r_red    = 1e-10 ! 1e-12
  ins_ti_bdf2_opts%r_max    = 1e-12 ! 1e-14
!
! Runge-Kutta options
!   n_stage   method      IMEX-RK
!      2        1         Euler
!      3        1         CB2
!      3        2         trapezoidal rule
!      4        1         CB3c
!      4        2         CB3e
!      5        1         ARS443
!      6        1         CB4
!      8        1         ARK5(4)8L[2]SA
  ins_ti_runge_kutta_opts%n_stage  = 5     ! 5
  ins_ti_runge_kutta_opts%method   = 1     ! 1
  ins_ti_runge_kutta_opts%i_max_p  = 1000  ! 1000
  ins_ti_runge_kutta_opts%i_max_v  = 10    ! 1000
  ins_ti_runge_kutta_opts%r_red    = 1e-10 ! 1e-12
  ins_ti_runge_kutta_opts%r_max    = 1e-12 ! 1e-14

  t_end  = 0.25
  dt     = 2e-4
  nt_max = 5
!
  export_vtk = F  ! set T for generating plot files
! char_freq  = 2  ! set to control frequency of control output
! avg_rate   = 0  ! averaging deactivated on start

! log_level_inner_iteration = 1  ! set log level > 0 for higher verbosity

! restart_tag_in  = 'test1'
  restart_tag_out = 'test1'
/

! flow_domain  =  1
&cuboid_cartesian_prm
! regular    = F ! mimic irregular mesh (elements deformed or of different size)
! structured = F ! mimic unstructured mesh
  xo    =  3*0.0
  lx(1) =  12.56637061435917295376d+0  ! 4π
  lx(2) =  6.28318530717958647688d+0   ! 2π
  lx(3) =  2.0

  np =  2,2,1  ! num partitions per direction             ! small mesh for
  ep =  4,4,8  ! num elements per direction and partition ! for playing around

! np =  4,4,8  ! num partitions per direction             ! large mesh for
! ep =  6,6,3  ! num elements per direction and partition ! real study

! pg = 1
  periodic = T,T,F
/
