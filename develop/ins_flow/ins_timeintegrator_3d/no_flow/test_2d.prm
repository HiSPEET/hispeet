!-------------------------------------------------------------------------------
! Control

&control_prm

! log_level                 = 1  ! activate/increase
! log_level_inner_iteration = 1  ! for higher
! log_level_outer_iteration = 1  ! verbosity

  problem_file = 'no_flow_2d'
  flow_problem = 'NoFlow'
  flow_domain  = 1

! export_vtk   = T  ! set T for generating plot files
! char_freq    = 0  ! set frequency of control output
/

!-------------------------------------------------------------------------------
! Spatial

&spatial_prm

  po_u = 3
  po_p = 2

  ins_op_opt%dealiasing = F
  ins_op_opt%mu_0       = 1000

! use these for coupled pressure-diffusion Krylov solver
! ins_op_opt%i_max_p  = 10000
! ins_op_opt%i_max_v  = 10000
! ins_op_opt%k_max    = 3
! ins_op_opt%k_pre_p  = 1000
! ins_op_opt%k_pre_v  = 1000

! use these for segregated pressure-diffusion solver
  ins_op_opt%i_max_p  = 10000
  ins_op_opt%i_max_v  = 10000
/

!-------------------------------------------------------------------------------
! Temporal

&temporal_prm

  t_end  = 1
  dt     = 1e-4
  nt_max = 10000

  time_method = 2  ! BDF2
/

!-------------------------------------------------------------------------------
! Domain

&cuboid_cartesian_prm
  regular    = T ! mimic irregular mesh (deformed elements)
  structured = T ! mimic unstructured mesh
  xo = 0.0, 0.0, 0.000
  lx = 1.0, 1.0, 0.03125
  periodic = F,F,T

! for serial runs
  np = 2*1 , 1
  ep = 2*32, 1

! for parallel runs
! np = 2*8 , 1
! ep = 2*4 , 1
/
