&control_prm
! flow_problem =  'Vortex_TG'
! problem_file =  'vortex_tg'
  flow_domain  =  3
  problem_file =  'variable_viscosity'
  flow_problem =  'VariableViscosity'
!
! ins_op_opts%mu = -2
  ins_op_opts%eop_v%StandardOperatorOptions_1D%po =  7 ! %StandardOperatorOptions_1D
  ins_op_opts%eop_p%StandardOperatorOptions_1D%po =  6 ! required with ifort < 2021.7
  ins_op_opts%sop_q%po = 11
  ins_op_opts%sop_q%basis = 'L'
!
  export_vtk = T
/

&cuboid_cartesian_prm
  regular    = F ! mimic irregular mesh (elements deformed or of different size)
  structured = F ! mimic unstructured mesh
  xo = 3*-0.5
  lx = 3*1
  np = 1,1,1
  ep = 3*2
! pg = 1
! periodic = 3*F
/

&cuboid_diamonds_prm
! pg = 1
! periodic = F
/

&cylinder_prm
  r  = 0.5
  h  = 1.0
  nr = 2
  nz = 2
  pg = 15
! periodic = F
/

&annulus_prm
! pg = 3
! periodic = F
/
