&problem_parameters
  v  = 1
  nu = 1e-4
  t_end = 1
/

&wave_package_dimensions
  nw = 7
  lw = 1
/

&wave_parameters
  k = 1,    3,    5,    7,    9,    12,   15
  a = 1.00, 1.50, 1.80, 1.70, 1.50, 1.30, 1.15
  s = 0.00, 0.05, 0.10, 0.15, 0.20, 0.30, 0.18
/

&discretization_parameters
  po  = 15
  ne  = 15
! cfl = 0.128
  dt  = 1e-4
! nt  = 0
! method = 1    ! IMEX Euler
! method = 2    ! IMEX BDF2
  method = 3    ! IMEX BDF3
! method = 4    ! IMEX Runge-Kutta
! method = 5    ! variable additive Runge-Kutta
! method = 6    ! SDC based on IMEX Euler
! method = 7    ! SDC based on variable additive Runge-Kutta
flying_start = T
/

! required with method = 4 (IMEX Runge-Kutta)
&imex_rk_parameters
  ns     = 3    ! number of stages, ns ∈ {2,3,4,6,8}
  method = 2    ! method ∈ {1,2}[1], effective only with s=4
  show   = T    ! print VARK properties and coefficients
/

! required with method = 5 (variable additive Runge-Kutta)
&vark_parameters
  set  = 1      ! equidistant (1) or GLL (2) points
  ns_p = 4      ! number of principal stages, ns_p ∈ {2,4}
  so_p = 1      ! order  of principal stages, so_p ∈ {1,2}
  show = T      ! print IMEX RK properties and coefficients
/

! required with method = 6 (IMEX Euler SDC)
&euler_sdc_parameters
  n_sub   = 1   ! number of subintervals (M)
  n_sweep = 0   ! max num correction sweeps (K)
  set     = 2   ! equidistant (1) or GLL (2) points
/

! required with method = 7 (VARK SDC)
&vark_sdc_parameters
  n_sub   =  1  ! number of subintervals (M)
  n_sweep =  0  ! max num correction sweeps (K)
  set     =  2  ! equidistant (1) or GLL (2) points
  so_p    =  1  ! order of principal stages
/
