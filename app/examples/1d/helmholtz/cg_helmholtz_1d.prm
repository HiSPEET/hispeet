&problem_parameters
 lambda  =  1   ! Helmholtz parameter, lambda >= 0
 test    =  1   ! 1: u=sin(PI*x), 2: u=abs(x)**3
 init    =  0   ! 0: zero, 1: random initial guess
 bc(1)   = 'D'  ! left BC, 'D': Dirichlet, 'N': Neumann
 bc(2)   = 'N'  ! right BC
/

&solution_parameters
 po = 16        ! polynomial order
 ne = 1         ! number of elements
 method = 2     ! 1: conjugate gradients CG, 2: SC+GE
 !i_max = 10    ! max number iterations with CG
 r_max = 1e-10  ! Euclidic norm of terminal residual with CG
 svv   = T      ! switch for SVV activation
/
