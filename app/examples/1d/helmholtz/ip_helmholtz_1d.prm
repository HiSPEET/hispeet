&problem_parameters
 lambda  =  1   ! Helmholtz parameter, lambda >= 0
 test    =  1   ! 1: u=sin(PI*x), 2: u=abs(x)**3
 bc(1)   = 'D'  ! left BC, 'D': Dirichlet, 'N': Neumann
 bc(2)   = 'N'  ! right BC
/

&solution_parameters
 po = 15        ! polynomial order
 ne = 400       ! number of elements
 penalty = 2    ! penalty parameter > 1
/
