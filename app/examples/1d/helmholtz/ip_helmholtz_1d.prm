&problem_parameters
 lambda  =  1   ! Helmholtz parameter, lambda >= 0
 test    =  1   ! 1: u=sin(PI*x), 2: u=abs(x)**3
 bc(1)   = 'D'  ! left BC, 'D': Dirichlet, 'N': Neumann
 bc(2)   = 'N'  ! right BC
/

&solution_parameters
 eop_opt%po      = 15 ! polynomial order
 eop_opt%svv     = T  ! switch for SVV activation
 eop_opt%penalty = 2  ! penalty parameter > 1
 ne = 400             ! number of elements
/
