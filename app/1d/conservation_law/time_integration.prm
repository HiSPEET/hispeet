&input

  ! time-integration method ....................................................

  ! standalone or predictor method
  time_method = 4 ! 1  Euler
                  ! 2  Implicit streamline diffusion
                  ! 3  Runge-Kutta 
                  ! 4  TVD Runge-Kutta (default)

  ! SDC method
  sdc_method  = 4 ! 0  none (use standalone time integrator)
                  ! 1  based on Euler
                  ! 2  based on ISD of order 1
                  ! 3  based on Runge-Kutta (default)
                  ! 4  based on TVD-Runge-Kutta 

  ! standalone integrator and predictor options ................................

  ! Euler
  tint_opt_eu%impl        = 0  ! 0/1/2: explicit/implicit/IMEX

  ! implicit streamline diffusion
  !tint_opt_sd%order       = 1  ! theoretical order of convergence {1,2} [1]
  !tint_opt_sd%method      = 1  ! 1: MP, 2: TR, default: TR/MP, for order 2 only

  ! Runge-Kutta
  tint_opt_rk%impl        = 0  ! 0/1/2: explicit/implicit/IMEX
  tint_opt_rk%n_stage     = 1  ! number of stages
  tint_opt_rk%method      = 2  ! RK method selector, if more than one exist

  ! TVD Runge-Kutta
  tint_opt_tvdrk%impl     = 0  ! 0/1/2: explicit/implicit/IMEX

  ! SDC options ................................................................

  ! SDC based on Euler
  sdc_opt_eu%n_sub        = 3  ! number of subintervals
  sdc_opt_eu%n_sweep      = 5  ! max number of correction sweeps
  sdc_opt_eu%point_set    = 2  ! equidistant (1) or Lobatto (2) points
  sdc_opt_eu%impl         = 0  ! 0/1/2: explicit/implicit/IMEX

  ! SDC based on ISD
!  sdc_opt_sd%n_sub        = 3  ! number of subintervals
!  sdc_opt_sd%n_sweep      = 5  ! max number of correction sweeps
!  sdc_opt_sd%point_set    = 2  ! equidistant (1) or Lobatto (2) points

  ! SDC based on Runge-Kutta
  sdc_opt_rk%n_sub        = 3  ! number of subintervals
  sdc_opt_rk%n_sweep      = 5  ! max number of correction sweeps
  sdc_opt_rk%point_set    = 2  ! equidistant (1) or Lobatto (2) points
  sdc_opt_rk%impl         = 0  ! 0/1/2: explicit/implicit/IMEX
  sdc_opt_rk%n_stage      = 3  !< number of stages of the RK corrector
  sdc_opt_rk%method       = 2  !< RK method selector, if more than one exist

  ! SDC based on TVD-Runge-Kutta
  sdc_opt_tvdrk%n_sub     = 3  ! number of subintervals
  sdc_opt_tvdrk%n_sweep   = 5  ! max number of correction sweeps
  sdc_opt_tvdrk%point_set = 2  ! equidistant (1) or Lobatto (2) points
  sdc_opt_tvdrk%impl      = 0  ! 0/1/2: explicit/implicit/IMEX

/
