&control_prm
! log_level = 1
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
/

&problem_prm
  problem_name = 'convection_diffusion__wave_package'
/

&space_discretization_prm
  cl_operator_opt%ne          = 75
  cl_operator_opt%eop%po      =  3
  cl_operator_opt%eop%penalty = 10
  cl_operator_opt%qop%po      =  3
/

&time_integration_prm

  t_end  = 1.0
! dt     = 4.004450e-3  ! cfl =  1
! dt     = 8.008900e-3  ! cfl =  2
! dt     = 1.201335e-2  ! cfl =  3
! dt     = 1.601780e-2  ! cfl =  4
! dt     = 2.002225e-2  ! cfl =  5
  dt     = 2.402670e-2  ! cfl =  6
! dt     = 2.803115e-2  ! cfl =  7
! dt     = 3.203560e-2  ! cfl =  8
! dt     = 6.407120e-2  ! cfl = 16
  nt_max = 1000000

  time_method = 2
  sdc_method  = 2

  ! time_method = 1: Euler
  cl_tint_euler_opt%impl             =   1
  cl_tint_euler_opt%diffusion_method =   4
  cl_tint_euler_opt%diffusion_i_max  = 100

  ! time_method = 2: ISD of order 1
  cl_tint_isd1_opt%impl              =   1
  cl_tint_isd1_opt%diffusion_method  =   4
  cl_tint_isd1_opt%diffusion_i_max   = 100
! cl_tint_isd1_opt%method            =   2

  ! time_method = 3: ISD of order 2
  cl_tint_isd2_opt%impl              =   1
  cl_tint_isd2_opt%diffusion_method  =   4
  cl_tint_isd2_opt%diffusion_i_max   = 100

  ! time_method = 4: Runge-Kutta
  cl_tint_rk_opt%impl                =   1
  cl_tint_rk_opt%n_stage             =   4
  cl_tint_rk_opt%method              =   1
  cl_tint_rk_opt%diffusion_method    =   4
  cl_tint_rk_opt%diffusion_i_max     = 100

  ! sdc_method = 1: SDC based on Euler
  cl_sdc_euler_opt%point_set         = 'RR'
  cl_sdc_euler_opt%n_col             =   3
  cl_sdc_euler_opt%n_sweep           =   6
  cl_sdc_euler_opt%diffusion_method  =   4
  cl_sdc_euler_opt%diffusion_i_max   = 100

  ! sdc_method = 2: SDC based on ISD1
  cl_sdc_isd1_opt%point_set          =  'RR'
  cl_sdc_isd1_opt%n_col              =    3
  cl_sdc_isd1_opt%n_sweep            =    6
  cl_sdc_isd1_opt%diffusion_method   =    4
  cl_sdc_isd1_opt%diffusion_i_max    =  100
  cl_sdc_isd1_opt%method             =    2

/

&convection_diffusion_wave_package_prm
! v  = 1
  nu = 0e-3
  bc = 2*'P'
/

&wave_package_dim
  nw = 7
  lw = 1
/

&wave_package_prm
  k = 1,    3,    5,    7,    9,    12,   15
  a = 1.00, 1.50, 1.80, 1.70, 1.50, 1.30, 1.15
  s = 0.00, 0.05, 0.10, 0.15, 0.20, 0.30, 0.18
/

