&problem_prm
  problem_name = 'convection_diffusion__wave_package'
/

&discretization_prm
! dt_slab =  0.2     ! thickness of one time slab
  n_level =  2       ! number of space-time levels
  n_space = 10  10
  p_space = 11  11 
  n_time  = 10  20
  p_time  =  7   9
  n_sweep =  4   4
/

&component_testing_prm
! 0 = no testing
! 1 = testing, no visualization
! 2 = testing with visualization 
  projection_switch    = 2 ! projection test switch
  interpolation_switch = 2 ! interpolation test switch
  residual_switch      = 2 ! collocation residual test switch
  restriction_switch   = 2 ! restriction test switch
  predictor_switch     = 2 ! predictor test switch
  corrector_switch     = 2 ! corrector test switch
/

&convection_diffusion_wave_package_prm
! v  = 1
  nu = 1e-4
  bc = 2*'P'
/

&wave_package_dim
  nw = 7
  lw = 1
/

&wave_package_prm
  k = 1,    3,    5,    7,    9,    12,   15
  a = 1.00, 1.50, 1.80, 1.70, 1.50, 1.30, 1.15
  s = 0.00, 0.05, 0.10, 0.15, 0.20, 0.30, 0.18
/


