&control_prm
! log_level = 1
! log_level_inner_iteration = 1
! log_level_outer_iteration = 1
/

&problem_prm
  problem_name = 'cns__contact_layer'
/

&space_discretization_prm
  cl_operator_opt%ne          =  5
  cl_operator_opt%eop%po      = 15
  cl_operator_opt%eop%penalty = 20
  cl_operator_opt%qop%po      = 22
/

&time_integration_prm

  t_end  = 1e-2
  dt     = 1e-5
  nt_max = 1!000000

  time_method = 2
  sdc_method  = 0

  ! time_method = 1: Euler
  cl_tint_euler_opt%impl = 1
! cl_tint_euler_opt%diffusion_method = 4
  cl_tint_euler_opt%diffusion_i_max  = 10!0

  ! time_method = 2: ISD of order 1
  cl_tint_isd1_opt%impl  = 1
  cl_tint_isd1_opt%diffusion_method = 4
  cl_tint_isd1_opt%diffusion_i_max  = 100

  ! time_method = 3: ISD of order 2
  cl_tint_isd2_opt%impl  = 1
  cl_tint_isd2_opt%diffusion_method = 4
  cl_tint_isd2_opt%diffusion_i_max  = 100

  ! time_method = 4: Runge-Kutta
  cl_tint_rk_opt%impl    = 1
  cl_tint_rk_opt%n_stage = 4
  cl_tint_rk_opt%method  = 1
  cl_tint_rk_opt%diffusion_method = 4
  cl_tint_rk_opt%diffusion_i_max  = 100

  ! sdc_method = 2: SDC based on ISD1
  cl_sdc_isd1_opt%n_sub     = 1
  cl_sdc_isd1_opt%point_set = 2
  cl_sdc_isd1_opt%n_sweep   = 0
  cl_sdc_isd1_opt%diffusion_method = 4
  cl_sdc_isd1_opt%diffusion_i_max  = 100

/

&cns_contact_layer_prm
  contact_layer_opt%eta = 1e-3
/
