&problem_parameters
  lambda  =  1   ! Helmholtz parameter, lambda >= 0
  test    =  1   ! 1: u=sin(PI*x), 2: u=abs(x)**3
  nu_p    =  1   ! physical diffusivity
  bc(1)   = 'D'  ! left BC, 'D': Dirichlet, 'N': Neumann
  bc(2)   = 'N'  ! right BC
/

&solution_parameters
  dg_opt%po          = 16    ! polynomial order
  dg_opt%hybrid      = T     ! T/F: hybridizable/standard IP method
  dg_opt%svv         = F     ! T/F: with/without SVV
  dg_opt%penalty     = 2     ! penalty parameter > 1
  schwarz_opt%no_min = 1     ! Schwarz minimal overlap
  ne                 = 2     ! number of elements
  method             = 1     ! 1/2/3/4: hybrid/CG/Schwarz/Schwarz-IPCG
! i_max              = 1000  ! max num iterations
! r_red              = 1e-8  ! targeted residual reduction
! r_max              = 1e-12 ! targeted maximum residual
/
