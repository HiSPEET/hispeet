&problem_prm
  v  = 1
  nu = 1e-2
  t_end = 1
/

&wave_package_dim
  nw = 7
  lw = 1
/

&wave_package_prm
  k = 1,    3,    5,    7,    9,    12,   15
  a = 1.00, 1.50, 1.80, 1.70, 1.50, 1.30, 1.15
  s = 0.00, 0.05, 0.10, 0.15, 0.20, 0.30, 0.18
/

&discretization_prm
  po  = 15
  ne  = 15
! cfl = 0.128
  dt  = 1e-2
! nt  = 0
! method = 1    ! IMEX Euler
! method = 2    ! IMEX BDF2
! method = 3    ! IMEX BDF3
! method = 4    ! IMEX Runge-Kutta
! method = 5    ! SDC based on IMEX Euler
! method = 6    ! SDC based on IMEX Runge-Kutta
method = 6
flying_start = T
/

! required with method = 4 (IMEX Runge-Kutta)
&imex_rk_prm
  ns     = 4    ! number of stages, ns ∈ {2,3,4,6,8}
  method = 2    ! method ∈ {1,2}[1], effective only with s=4
  show   = T    ! print IMEX RK properties and coefficients
/

! required with method = 5 (IMEX Euler SDC)
&sdc_euler_prm
  point_set     = 'L' ! equidistant/Lobatto/Radau-right (E/L/RR)
  n_col         =  4  ! number of collocation points
  n_sweep       =  5  ! max num correction sweeps (K)
/
! required with method = 6 (IMEX Runge-Kutta SDC)
&rk_sdc_parameters
  ! SDC
  point_set = 'E' ! equidistant/Lobatto/Radau-right (E/L/RR)
  n_col     =  4  ! number of collocation points
  n_sweep   =  1  ! max num SDC correction sweeps (K)
                  ! IMEX Runge-Kutta ----------------------------
  n_stage   =  4  ! number of stages, ns ∈ {2,3,4,6,8}
  method    =  2  ! method ∈ {1,2}[1], effective only with s=4
  show      =  T  ! print RK properties and coefficients
/
